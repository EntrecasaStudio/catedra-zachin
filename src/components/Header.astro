---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/nivel-1', label: 'Nivel 1' },
  { href: '/nivel-2', label: 'Nivel 2' },
  { href: '/equipo', label: 'Equipo' },
  { href: '/galeria', label: 'Galería' },
  { href: '/trabajos', label: 'Trabajos' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner container">
    <a href="/" class="header__logo" aria-label="Cátedra Zachin - Inicio">
      <img src="/images/logo-white.svg" alt="Tecnología Zachin" class="header__logo-img header__logo-dark" width="741" height="202" />
      <img src="/images/logo-black.svg" alt="Tecnología Zachin" class="header__logo-img header__logo-light" width="741" height="202" />
    </a>

    <nav class="header__nav" id="main-nav" aria-label="Navegación principal">
      <ul class="header__nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['header__nav-link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <button id="theme-toggle" class="header__theme-toggle" aria-label="Cambiar tema">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button class="header__burger" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-base);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-lg);
  }

  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-img {
    height: 2rem;
    width: auto;
  }

  /* Theme-based logo switching */
  :global([data-theme="dark"]) .header__logo-dark { display: block; }
  :global([data-theme="dark"]) .header__logo-light { display: none; }
  :global([data-theme="light"]) .header__logo-dark { display: none; }
  :global([data-theme="light"]) .header__logo-light { display: block; }

  .header__nav-list {
    display: flex;
    gap: var(--space-md);
  }

  .header__nav-link {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: var(--space-xs) 0;
    position: relative;
  }

  .header__nav-link:hover,
  .header__nav-link.active {
    color: var(--color-magenta);
  }

  .header__nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-magenta);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header__theme-toggle {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color var(--transition-fast);
  }

  .header__theme-toggle:hover {
    background-color: var(--color-bg-elevated);
  }

  [data-theme="dark"] .icon-sun { display: block; }
  [data-theme="dark"] .icon-moon { display: none; }
  [data-theme="light"] .icon-sun { display: none; }
  [data-theme="light"] .icon-moon { display: block; }

  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 28px;
    padding: 4px 0;
  }

  .header__burger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
    transition: all var(--transition-fast);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .header__burger {
      display: flex;
    }

    .header__nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      bottom: 0;
      background-color: var(--color-bg);
      padding: var(--space-lg);
      transform: translateX(100%);
      transition: transform var(--transition-base);
      z-index: 99;
    }

    .header__nav.open {
      transform: translateX(0);
    }

    .header__nav-list {
      flex-direction: column;
      gap: var(--space-lg);
    }

    .header__nav-link {
      font-size: 1.25rem;
    }

    .header__burger.open span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .header__burger.open span:nth-child(2) {
      opacity: 0;
    }
    .header__burger.open span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const burger = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');
    if (!burger || !nav) return;

    burger.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      burger.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(isOpen));
    });

    // Close menu on link click
    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('open');
        burger.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
      });
    });
  });
</script>
