---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/nivel-1', label: 'Tecnología 1', nivel: 1 },
  { href: '/nivel-2', label: 'Tecnología 2', nivel: 2 },
  { href: '/equipo', label: 'Plantel docente' },
  { href: '/galeria', label: 'Galería' },
  { href: '/trabajos', label: 'Trabajos' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner container">
    <!-- Logo: circle iso only -->
    <a href="/" class="header__logo" aria-label="Cátedra Zachin - Inicio">
      <img src="/images/logo-iso-white.svg" alt="Cátedra Zachin" class="header__logo-img header__logo-dark" />
      <img src="/images/logo-iso-black.svg" alt="Cátedra Zachin" class="header__logo-img header__logo-light" />
    </a>

    <!-- Navigation -->
    <nav class="header__nav" id="main-nav" aria-label="Navegación principal">
      <ul class="header__nav-list">
        {navLinks.map((link, i) => (
          <li class="header__nav-item" style={`--i: ${i}`}>
            <a
              href={link.href}
              class:list={['header__nav-link', { active: currentPath === link.href, 'nivel-1': link.nivel === 1, 'nivel-2': link.nivel === 2 }]}
            >
              <svg class="header__nav-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
              <span class="header__nav-label">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <!-- Theme toggle inside menu (mobile) -->
      <div class="header__nav-footer">
        <button class="theme-toggle theme-toggle--mobile" aria-label="Cambiar tema">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" stroke-linecap="round">
            <clipPath id="theme-clip-m">
              <path d="M0-5h30a1 1 0 0 0 9 13v24H0Z" class="toggle__clip-path"/>
            </clipPath>
            <g clip-path="url(#theme-clip-m)">
              <circle class="toggle__circle" cx="16" cy="16" r="8"/>
              <g class="toggle__rays" stroke="currentColor" stroke-width="1.5">
                <path d="M16 5.5v-4"/><path d="M16 30.5v-4"/>
                <path d="M1.5 16h4"/><path d="M26.5 16h4"/>
                <path d="m23.4 8.6 2.8-2.8"/><path d="m5.7 26.3 2.9-2.9"/>
                <path d="m5.8 5.8 2.8 2.8"/><path d="m23.4 23.4 2.9 2.9"/>
              </g>
            </g>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Actions -->
    <div class="header__actions">
      <!-- Theme toggle (desktop) -->
      <button class="theme-toggle theme-toggle--desktop" aria-label="Cambiar tema">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" stroke-linecap="round">
          <clipPath id="theme-clip-d">
            <path d="M0-5h30a1 1 0 0 0 9 13v24H0Z" class="toggle__clip-path"/>
          </clipPath>
          <g clip-path="url(#theme-clip-d)">
            <circle class="toggle__circle" cx="16" cy="16" r="8"/>
            <g class="toggle__rays" stroke="currentColor" stroke-width="1.5">
              <path d="M16 5.5v-4"/><path d="M16 30.5v-4"/>
              <path d="M1.5 16h4"/><path d="M26.5 16h4"/>
              <path d="m23.4 8.6 2.8-2.8"/><path d="m5.7 26.3 2.9-2.9"/>
              <path d="m5.8 5.8 2.8 2.8"/><path d="m23.4 23.4 2.9 2.9"/>
            </g>
          </g>
        </svg>
      </button>

      <!-- Hamburger -->
      <button class="header__burger" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false">
        <div class="burger__lines">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </div>
</header>

<style>
  /* ==============================
     Header Shell
     ============================== */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: color-mix(in srgb, var(--color-bg) 95%, transparent);
    transition: background-color var(--transition-base);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-lg);
  }

  /* ==============================
     Logo: circle iso
     ============================== */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-img {
    height: 2.25rem;
    width: 2.25rem;
    object-fit: contain;
  }

  :global([data-theme="dark"]) .header__logo-dark { display: block; }
  :global([data-theme="dark"]) .header__logo-light { display: none; }
  :global([data-theme="light"]) .header__logo-dark { display: none; }
  :global([data-theme="light"]) .header__logo-light { display: block; }

  /* ==============================
     Desktop Nav
     ============================== */
  .header__nav-list {
    display: flex;
    gap: var(--space-md);
  }

  .header__nav-arrow { display: none; }
  .header__nav-footer { display: none; }

  .header__nav-link {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: var(--space-xs) 0;
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__nav-link:hover {
    color: var(--color-text);
  }

  .header__nav-link.active {
    color: var(--color-text);
  }

  .header__nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-text);
  }

  /* ==============================
     Actions
     ============================== */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* ==============================
     Theme Toggle (sun/moon clipPath)
     ============================== */
  .theme-toggle {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color var(--transition-fast), transform 0.2s ease;
    color: var(--color-text);
  }

  .theme-toggle:hover {
    background-color: var(--color-bg-elevated);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }

  .theme-toggle svg {
    width: 22px;
    height: 22px;
  }

  /* clipPath animation */
  .toggle__clip-path {
    transition: transform 0.35s ease-in-out;
  }

  :global([data-theme="dark"]) .toggle__clip-path {
    transform: translate(-12px, 10px);
  }

  /* Circle grows in dark mode */
  .toggle__circle {
    transition: transform 0.35s ease-in-out;
    transform-origin: 16px 16px;
  }

  :global([data-theme="dark"]) .toggle__circle {
    transform: scale(1.25);
  }

  /* Rays fade/rotate in dark mode */
  .toggle__rays {
    transition: transform 0.35s ease-in-out, opacity 0.35s ease-in-out;
    transform-origin: 16px 16px;
  }

  :global([data-theme="dark"]) .toggle__rays {
    transform: rotate(-100deg) scale(0.5);
    opacity: 0;
  }

  /* ==============================
     Hamburger: smooth 3-line → X
     ============================== */
  .header__burger {
    display: none;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background-color var(--transition-fast);
  }

  .header__burger:hover {
    background-color: var(--color-bg-elevated);
  }

  .burger__lines {
    width: 24px;
    height: 18px;
    position: relative;
  }

  .burger__lines span {
    display: block;
    position: absolute;
    left: 50%;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-text);
    border-radius: 1px;
    transform-origin: center;
    transform: translateX(-50%);
    /* X → ☰ : unrotate first, then expand middle */
    transition:
      width 0.25s cubic-bezier(0.23, 1, 0.32, 1) 0.12s,
      opacity 0.2s ease 0.12s,
      transform 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0s,
      top 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0s;
  }

  .burger__lines span:nth-child(1) { top: 2px; }
  .burger__lines span:nth-child(2) {
    top: 8px;
    /* X → ☰ reverse: appear as dot first, then grow to full width */
    transition:
      opacity 0.15s ease 0.05s,
      width 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.15s,
      transform 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0s,
      top 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0s;
  }
  .burger__lines span:nth-child(3) { top: 14px; }

  /* ☰ → X : shrink middle to dot first, then rotate */
  .header__burger.open .burger__lines span {
    transition:
      width 0.2s cubic-bezier(0.23, 1, 0.32, 1) 0s,
      opacity 0.15s ease 0.1s,
      transform 0.35s cubic-bezier(0.23, 1, 0.32, 1) 0.12s,
      top 0.35s cubic-bezier(0.23, 1, 0.32, 1) 0.12s;
  }

  .header__burger.open .burger__lines span:nth-child(1) {
    top: 8px;
    transform: translateX(-50%) rotate(45deg);
  }

  .header__burger.open .burger__lines span:nth-child(2) {
    width: 3px;
    opacity: 0;
    transition:
      width 0.2s cubic-bezier(0.23, 1, 0.32, 1) 0s,
      opacity 0.2s ease 0.2s;
  }

  .header__burger.open .burger__lines span:nth-child(3) {
    top: 8px;
    transform: translateX(-50%) rotate(-45deg);
  }

  /* ======================
     Mobile: Vertical Menu
     ====================== */
  @media (max-width: 768px) {
    .header__burger {
      display: flex;
    }

    .theme-toggle--desktop {
      display: none;
    }

    .header__nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-height));
      background-color: var(--color-bg);
      padding: var(--space-xl) var(--space-lg) var(--space-lg);
      transform: translateX(100%);
      transition: transform var(--transition-base);
      z-index: 99;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .header__nav.open {
      transform: translateX(0);
    }

    .header__nav-list {
      flex-direction: column;
      gap: 0.375rem;
      width: 100%;
      padding-left: var(--space-sm);
      flex: 1;
    }

    /* Staggered entrance */
    .header__nav-item {
      opacity: 0;
      transform: translateX(30px);
    }

    .header__nav.open .header__nav-item {
      animation: menuSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(0.05s + var(--i) * 0.04s);
    }

    @keyframes menuSlideIn {
      from { opacity: 0; transform: translateX(30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* Vertical menu link style */
    .header__nav-link {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      font-size: clamp(1.5rem, 5vw, 2rem);
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--color-text);
      padding: var(--space-xs) 0;
      transition: color 0.3s ease-out, transform 0.3s ease-out;
      overflow: hidden;
    }

    .header__nav-link:hover {
      color: var(--color-text);
      transform: translateX(4px);
    }

    .header__nav-link.active {
      color: var(--color-text);
    }

    .header__nav-link.active::after { display: none; }

    /* Arrow */
    .header__nav-arrow {
      display: block;
      width: 28px;
      height: 28px;
      flex-shrink: 0;
      opacity: 0;
      transform: translateX(-100%);
      transition: opacity 0.3s ease-out, transform 0.3s ease-out;
      color: var(--color-text);
    }

    .header__nav-link:hover .header__nav-arrow,
    .header__nav-link.active .header__nav-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    /* Level-specific arrow colors */
    .header__nav-link.nivel-1:hover .header__nav-arrow,
    .header__nav-link.nivel-1.active .header__nav-arrow {
      color: var(--color-magenta);
    }

    .header__nav-link.nivel-2:hover .header__nav-arrow,
    .header__nav-link.nivel-2.active .header__nav-arrow {
      color: var(--color-cyan);
    }

    /* Label shift */
    .header__nav-label {
      display: block;
      transition: transform 0.3s ease-out;
      transform: translateX(-36px);
    }

    .header__nav-link:hover .header__nav-label,
    .header__nav-link.active .header__nav-label {
      transform: translateX(0);
    }

    /* Nav footer with theme toggle */
    .header__nav-footer {
      display: flex;
      align-items: center;
      padding-top: var(--space-lg);
      margin-top: auto;
    }

    .theme-toggle--mobile {
      width: 44px;
      height: 44px;
    }

    .theme-toggle--mobile svg {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const burger = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');
    if (!burger || !nav) return;

    // Hamburger toggle
    burger.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      burger.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(isOpen));
    });

    // Close menu on link click
    nav.querySelectorAll('.header__nav-link').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('open');
        burger.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
      });
    });

    // Theme toggles (desktop + mobile)
    document.querySelectorAll('.theme-toggle').forEach(toggle => {
      const newToggle = toggle.cloneNode(true);
      toggle.parentNode?.replaceChild(newToggle, toggle);
      newToggle.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    });
  });
</script>
