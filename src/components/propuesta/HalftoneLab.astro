---
/**
 * HalftoneLab — el juego de semitono CMYK, directo y sin texto.
 * Es la pieza interactiva en sí: canvas + controles de canal, nada más.
 * Sólo anima mientras está visible en pantalla (IntersectionObserver) y
 * respeta prefers-reduced-motion.
 *
 * @prop {string} [id] - id base del bloque. Default 'halftone-lab'.
 */
interface Props {
  id?: string;
}
const { id = 'halftone-lab' } = Astro.props;

const channels = [
  { id: 'k', label: 'K', title: 'Negro · 45°' },
  { id: 'c', label: 'C', title: 'Cyan · 15°' },
  { id: 'm', label: 'M', title: 'Magenta · 75°' },
  { id: 'y', label: 'Y', title: 'Amarillo · 0°' },
];
---

<div class="pz-halftone" id={id} data-halftone-lab>
  <div class="pz-halftone__stage" data-stage>
    <canvas class="pz-halftone__canvas" id={`${id}-canvas`} aria-hidden="true"></canvas>
    <div class="pz-halftone__controls" role="group" aria-label="Canales CMYK">
      {channels.map((ch) => (
        <button
          type="button"
          class:list={['pz-channel-btn', `pz-channel-btn--${ch.id}`, { active: ch.id === 'k', selected: ch.id === 'k' }]}
          data-channel={ch.id}
          title={ch.title}
          aria-label={`Canal ${ch.title}`}
          aria-pressed={ch.id === 'k' ? 'true' : 'false'}
        >{ch.label}</button>
      ))}
    </div>
  </div>
</div>

<style>
  .pz-halftone__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 320px;
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    box-shadow: var(--pz-shadow);
    background: var(--pz-surface);
    overflow: hidden;
  }

  .pz-halftone__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    user-select: none;
  }

  .pz-halftone__controls {
    position: absolute;
    left: var(--pz-space-md);
    bottom: var(--pz-space-md);
    display: flex;
    gap: var(--pz-space-xs);
    z-index: 1;
  }

  .pz-channel-btn {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--pz-font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    background: var(--pz-bg);
    color: var(--pz-muted);
    box-shadow: var(--pz-shadow);
    transition: all var(--pz-transition);
  }

  .pz-channel-btn:hover { color: var(--pz-fg); transform: translate(var(--pz-lift), var(--pz-lift)); }

  .pz-channel-btn--k.active { background: var(--pz-fg); color: var(--pz-bg); border-color: var(--pz-fg); }
  .pz-channel-btn--c.active { background: #00aeef; color: #fff; border-color: #00aeef; }
  .pz-channel-btn--m.active { background: #ec008c; color: #fff; border-color: #ec008c; }
  .pz-channel-btn--y.active { background: #fff200; color: #000; border-color: #fff200; }

  .pz-channel-btn.selected { outline: 2px solid var(--pz-accent); outline-offset: 2px; }
</style>

<script>
  import { initHalftoneLab } from '../../scripts/halftone-lab.js';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-halftone-lab]').forEach((el) => {
      const lab = initHalftoneLab(el);
      if (!lab) return;

      // Corre sólo cuando la sección está en pantalla (ahorra CPU)
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? lab.start() : lab.stop())),
        { threshold: 0.1 }
      );
      io.observe(el);

      document.addEventListener(
        'astro:before-swap',
        () => { io.disconnect(); lab.destroy(); },
        { once: true }
      );
    });
  });
</script>
