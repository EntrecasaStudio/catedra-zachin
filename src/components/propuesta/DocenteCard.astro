---
/**
 * DocenteCard — ficha de un integrante del plantel.
 * Maneja imagen faltante (onerror → inicial) y carga diferida.
 *
 * @prop {{nombre:string, rol:string, nivel:string, foto?:string, linkedin?:string}} docente
 */
interface Props {
  docente: { nombre: string; rol: string; nivel: string; foto?: string; linkedin?: string };
}
const { docente } = Astro.props;
const inicial = docente.nombre.charAt(0).toUpperCase();
const nivelClass = docente.nivel === 'Nivel 1' ? 'n1' : docente.nivel === 'Nivel 2' ? 'n2' : '';
const nivelAbbr = docente.nivel === 'Nivel 1' ? 'N1' : docente.nivel === 'Nivel 2' ? 'N2' : docente.nivel;
---

<article class="pz-docente" data-nivel={docente.nivel}>
  <div class="pz-docente__avatar">
    <span class="pz-docente__initial" aria-hidden="true">{inicial}</span>
    {docente.foto && (
      <img
        src={docente.foto}
        alt={`Foto de ${docente.nombre}`}
        loading="lazy"
        decoding="async"
        width="200"
        height="200"
        onerror="this.style.display='none'"
      />
    )}
  </div>
  <h3 class="pz-docente__nombre">{docente.nombre}</h3>
  {docente.linkedin && (
    <a
      class="pz-docente__linkedin"
      href={docente.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`LinkedIn de ${docente.nombre}`}
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
      </svg>
    </a>
  )}
  <span class="pz-docente__rol">{docente.rol}</span>
  {nivelClass && <span class:list={['pz-docente__nivel', nivelClass]}>{nivelAbbr}</span>}
</article>

<style>
  .pz-docente {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--pz-space-2xs);
  }

  .pz-docente__avatar {
    position: relative;
    width: 100%; /* ocupa toda la columna (misma cantidad por fila, imágenes más grandes) */
    aspect-ratio: 1;
    margin-bottom: var(--pz-space-xs);
    /* Doble marco "contact sheet": el offset se dibuja como borde estático
       (no como box-shadow), para NO invocar el lenguaje de "pressable".
       El offset-shadow (--pz-shadow) queda reservado a superficies clicables. */
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    outline: var(--pz-border-width) solid var(--pz-fg);
    outline-offset: calc(-2 * var(--pz-border-width));
    background: var(--pz-surface);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .pz-docente__initial {
    font-family: var(--pz-font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--pz-muted);
  }

  .pz-docente__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter var(--pz-transition);
  }
  .pz-docente:hover .pz-docente__avatar img { filter: grayscale(0%); }

  .pz-docente__nombre { font-size: 0.95rem; }
  .pz-docente__linkedin {
    display: inline-flex;
    margin-top: var(--pz-space-2xs);
    color: var(--pz-muted);
    transition: color var(--pz-transition), transform var(--pz-transition);
  }
  .pz-docente__linkedin svg { width: 1rem; height: 1rem; }
  .pz-docente__linkedin:hover { color: var(--pz-fg); transform: translateY(-1px); }
  .pz-docente__rol {
    font-family: var(--pz-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pz-muted);
    margin-top: var(--pz-space-2xs);
  }
  .pz-docente__nivel {
    font-family: var(--pz-font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pz-docente__nivel.n1 { color: var(--pz-n1); }
  .pz-docente__nivel.n2 { color: var(--pz-n2); }
</style>
