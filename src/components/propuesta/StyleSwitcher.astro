---
/**
 * StyleSwitcher — conmuta la piel brutalista (refined/raw/neo) de toda la
 * propuesta. Setea [data-brutalism] en <html> y persiste en localStorage.
 * Accesible: role="radiogroup" + navegación con flechas.
 *
 * No recibe props; el estado inicial lo aplica el script pre-paint del layout.
 */
const options = [
  { value: 'refined', label: 'Refined', hint: 'DIN · sobrio' },
  { value: 'raw', label: 'Raw', hint: 'Mono · crudo' },
  { value: 'neo', label: 'Neo', hint: 'Sombra · pop' },
];
---

<div class="pz-switcher" role="radiogroup" aria-label="Estilo brutalista">
  <span class="pz-switcher__label" aria-hidden="true">Estilo</span>
  <div class="pz-switcher__options">
    {options.map((o, i) => (
      <button
        type="button"
        class="pz-switcher__btn"
        role="radio"
        aria-checked={i === 0 ? 'true' : 'false'}
        data-brutalism-value={o.value}
        tabindex={i === 0 ? '0' : '-1'}
      >
        <span class="pz-switcher__btn-label">{o.label}</span>
        <span class="pz-switcher__btn-hint">{o.hint}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .pz-switcher {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: var(--pz-space-2xs);
    padding: var(--pz-space-xs);
    background: var(--pz-bg);
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    box-shadow: var(--pz-shadow, 4px 4px 0 var(--pz-shadow-color));
  }

  .pz-switcher__label {
    font-family: var(--pz-font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--pz-muted);
    padding-inline: var(--pz-space-2xs);
  }

  .pz-switcher__options { display: flex; gap: var(--pz-space-2xs); }

  .pz-switcher__btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: var(--pz-space-2xs) var(--pz-space-xs);
    border: var(--pz-border-width) solid transparent;
    border-radius: var(--pz-radius);
    transition: all var(--pz-transition);
    text-align: left;
  }

  .pz-switcher__btn:hover { border-color: var(--pz-muted); }

  .pz-switcher__btn[aria-checked='true'] {
    background: var(--pz-accent);
    color: var(--pz-on-accent);
    border-color: var(--pz-accent);
  }

  .pz-switcher__btn-label {
    font-family: var(--pz-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .pz-switcher__btn-hint {
    font-family: var(--pz-font-mono);
    font-size: 0.5625rem;
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  @media (max-width: 560px) {
    .pz-switcher__btn-hint { display: none; }
  }
</style>

<script>
  const KEY = 'pz-brutalism';
  const VALUES = ['refined', 'raw', 'neo'];

  function apply(value) {
    if (!VALUES.includes(value)) value = 'refined';
    document.documentElement.setAttribute('data-brutalism', value);
    try { localStorage.setItem(KEY, value); } catch {}
    document.querySelectorAll('.pz-switcher__btn').forEach((btn) => {
      const active = btn.getAttribute('data-brutalism-value') === value;
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
      btn.setAttribute('tabindex', active ? '0' : '-1');
    });
  }

  function setup() {
    const group = document.querySelector('.pz-switcher');
    if (!group) return;
    const current = document.documentElement.getAttribute('data-brutalism') || 'refined';
    apply(current);

    const btns = Array.from(group.querySelectorAll('.pz-switcher__btn'));
    group.addEventListener('click', (e) => {
      const btn = e.target.closest('.pz-switcher__btn');
      if (btn) apply(btn.getAttribute('data-brutalism-value'));
    });

    // Navegación por flechas (patrón radiogroup)
    group.addEventListener('keydown', (e) => {
      if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(e.key)) return;
      e.preventDefault();
      const idx = btns.findIndex((b) => b.getAttribute('aria-checked') === 'true');
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
      const next = btns[(idx + dir + btns.length) % btns.length];
      apply(next.getAttribute('data-brutalism-value'));
      next.focus();
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
