---
/**
 * GaleriaItem — celda de la galería (foto o video). Expone data-* para el
 * filtrado y el lightbox de la página. Imágenes con dimensiones para evitar
 * layout shift y carga diferida.
 *
 * @prop {{tipo:'foto'|'video', src:string, alt:string, categoria:string}} item
 * @prop {number} index
 */
interface Props {
  item: { tipo: 'foto' | 'video'; src: string; alt: string; categoria: string };
  index: number;
}
const { item, index } = Astro.props;
// Thumbnail (poster) generado con ffmpeg: mismo path con sufijo -thumb.jpg
const poster = item.tipo === 'video' ? item.src.replace(/\.mp4$/, '-thumb.jpg') : undefined;
---

<button
  class="pz-galitem"
  data-reveal
  data-categoria={item.categoria}
  data-index={index}
  data-tipo={item.tipo}
  data-src={item.src}
  data-alt={item.alt}
  aria-label={`Ampliar: ${item.alt}`}
>
  <span class="pz-galitem__media">
    {item.tipo === 'foto' ? (
      <img src={item.src} alt={item.alt} loading="lazy" decoding="async" width="640" height="480" />
    ) : (
      <video src={item.src} poster={poster} muted loop playsinline preload="none"><track kind="captions" /></video>
    )}
  </span>
  {item.tipo === 'video' && (
    <span class="pz-galitem__play" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg>
    </span>
  )}
</button>

<style>
  /* La card lleva `data-reveal`: su transform (entrada + cascada) lo maneja el sistema
     de reveal. El hover NO toca el transform de la card (evita la colisión de
     especificidad con .is-revealed{transform:none} y el delay de cascada): sólo crece
     la sombra acá y el zoom vive en un wrapper interno propio. */
  .pz-galitem {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    box-shadow: var(--pz-shadow);
    background: var(--pz-surface);
    overflow: hidden;
    isolation: isolate; /* Safari: contexto de clip para el zoom del hijo */
    transition: box-shadow var(--pz-transition);
  }
  .pz-galitem:hover { box-shadow: var(--pz-shadow-hover); }

  /* Wrapper del medio: dueño del zoom del hover, con transición propia (sin delay de
     cascada). Se promueve a capa GPU SÓLO en hover (no permanente → sin sobrecarga). */
  .pz-galitem__media {
    position: absolute;
    inset: 0;
    transition: transform var(--pz-transition-slow);
  }
  .pz-galitem__media img,
  .pz-galitem__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pz-galitem:hover .pz-galitem__media {
    transform: scale(1.05);
    will-change: transform;
  }

  .pz-galitem__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  .pz-galitem[hidden] { display: none; }
</style>
