---
/**
 * PropuestaHeader — barra de navegación brutalista de la propuesta.
 * Nav sin Trabajos ni Inscripciones (coherente con la limpieza del sitio).
 */
const nav = [
  { href: '/propuesta/nivel-1', label: 'Tecnología 1' },
  { href: '/propuesta/nivel-2', label: 'Tecnología 2' },
  { href: '/propuesta/equipo', label: 'Plantel' },
  { href: '/propuesta/galeria', label: 'Galería' },
  { href: '/propuesta/contacto', label: 'Contacto' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/propuesta';
---

<header class="pz-header">
  <div class="pz-header__inner pz-container">
    <a href="/propuesta" class="pz-header__brand" aria-label="Cátedra Zachin — Inicio">
      <img src="/images/logo-iso-white.svg" alt="Cátedra Zachin" class="pz-header__logo pz-header__logo--dark" width="40" height="40" />
      <img src="/images/logo-iso-black.svg" alt="Cátedra Zachin" class="pz-header__logo pz-header__logo--light" width="40" height="40" />
    </a>

    <nav class="pz-header__nav" id="pz-nav" aria-label="Navegación de la propuesta">
      <ul class="pz-header__list">
        {nav.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['pz-header__link', { 'is-active': path === l.href }]}
              aria-current={path === l.href ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="pz-header__actions">
      <button class="pz-header__theme" id="pz-theme-toggle" type="button" aria-label="Cambiar tema claro/oscuro">
        <svg class="pz-theme-svg" viewBox="0 0 32 32" fill="currentColor" stroke-linecap="round" aria-hidden="true">
          <clipPath id="pz-theme-clip">
            <path class="toggle__clip-path" d="M0-5h30a1 1 0 0 0 9 13v24H0Z" />
          </clipPath>
          <g clip-path="url(#pz-theme-clip)">
            <circle class="toggle__circle" cx="16" cy="16" r="8" />
            <g class="toggle__rays" stroke="currentColor" stroke-width="1.5">
              <path d="M16 5.5v-4" /><path d="M16 30.5v-4" />
              <path d="M1.5 16h4" /><path d="M26.5 16h4" />
              <path d="m23.4 8.6 2.8-2.8" /><path d="m5.7 26.3 2.9-2.9" />
              <path d="m5.8 5.8 2.8 2.8" /><path d="m23.4 23.4 2.9 2.9" />
            </g>
          </g>
        </svg>
      </button>
      <button class="pz-header__burger" id="pz-burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="pz-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .pz-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--pz-header-height);
    background: color-mix(in srgb, var(--pz-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--pz-border-width) solid var(--pz-fg);
  }

  .pz-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--pz-space-lg);
  }

  .pz-header__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .pz-header__logo { width: 2.5rem; height: 2.5rem; object-fit: contain; }
  :global([data-theme='dark']) .pz-header__logo--dark { display: block; }
  :global([data-theme='dark']) .pz-header__logo--light { display: none; }
  :global([data-theme='light']) .pz-header__logo--dark { display: none; }
  :global([data-theme='light']) .pz-header__logo--light { display: block; }

  /* Nav a altura completa: el borde inferior del link coincide con el divisor */
  .pz-header__nav { align-self: stretch; }
  .pz-header__list { display: flex; gap: var(--pz-space-md); height: 100%; align-items: stretch; }
  .pz-header__list li { display: flex; }

  .pz-header__link {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    font-family: var(--pz-font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pz-muted);
    transition: color var(--pz-transition);
  }

  /* La línea de color "prende" el divisor del nav, justo debajo del link */
  .pz-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--pz-border-width));
    height: var(--pz-border-width);
    background: var(--pz-duo);
    transform: scaleX(0);
    transition: transform var(--pz-transition);
  }

  .pz-header__link:hover { color: var(--pz-fg); }
  .pz-header__link:hover::after,
  .pz-header__link.is-active::after { transform: scaleX(1); }
  .pz-header__link.is-active { color: var(--pz-fg); }

  .pz-header__actions { display: flex; align-items: center; gap: var(--pz-space-xs); }

  .pz-header__theme {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    transition: background var(--pz-transition);
  }
  .pz-header__theme:hover { background: var(--pz-surface); }

  /* Toggle sol/luna (clipPath animado, del sitio original) */
  .pz-theme-svg { width: 1.3rem; height: 1.3rem; color: var(--pz-fg); }
  .toggle__clip-path { transition: transform 0.35s ease-in-out; }
  :global([data-theme='dark']) .toggle__clip-path { transform: translate(-12px, 10px); }
  .toggle__circle { transition: transform 0.35s ease-in-out; transform-origin: 16px 16px; }
  :global([data-theme='dark']) .toggle__circle { transform: scale(1.25); }
  .toggle__rays {
    transition: transform 0.35s ease-in-out, opacity 0.35s ease-in-out;
    transform-origin: 16px 16px;
  }
  :global([data-theme='dark']) .toggle__rays { transform: rotate(-100deg) scale(0.5); opacity: 0; }

  .pz-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    padding: 0 0.5rem;
  }
  .pz-header__burger span { height: var(--pz-border-width); background: var(--pz-fg); transition: transform var(--pz-transition), opacity var(--pz-transition); }
  .pz-header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .pz-header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .pz-header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 860px) {
    .pz-header__burger { display: flex; }
    .pz-header__nav {
      position: fixed;
      inset: var(--pz-header-height) 0 auto 0;
      background: var(--pz-bg);
      border-bottom: var(--pz-border-width) solid var(--pz-fg);
      transform: translateY(-120%);
      transition: transform var(--pz-transition-slow);
      padding: var(--pz-space-lg);
    }
    .pz-header__nav.is-open { transform: translateY(0); }
    .pz-header__list { flex-direction: column; gap: var(--pz-space-sm); height: auto; align-items: stretch; }
    .pz-header__link { font-size: 1.1rem; height: auto; }
    /* En el panel mobile no hay divisor compartido: sin línea inferior */
    .pz-header__link::after { display: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const burger = document.getElementById('pz-burger');
    const nav = document.getElementById('pz-nav');
    if (burger && nav) {
      burger.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', String(open));
      });
      nav.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          nav.classList.remove('is-open');
          burger.setAttribute('aria-expanded', 'false');
        })
      );
    }

    const theme = document.getElementById('pz-theme-toggle');
    theme?.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme') || 'light';
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch {}
    });
  });
</script>
