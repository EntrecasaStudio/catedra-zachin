---
/**
 * PropuestaHeader — barra de navegación brutalista de la propuesta.
 * Nav sin Trabajos ni Inscripciones (coherente con la limpieza del sitio).
 * En mobile: menú fullscreen slide-in con entrada escalonada y toggle de tema adentro.
 */
const nav = [
  { href: '/nivel-1', label: 'N1', full: 'Nivel 1', tone: 'n1' },
  { href: '/nivel-2', label: 'N2', full: 'Nivel 2', tone: 'n2' },
  { href: '/equipo', label: 'Plantel', full: 'Plantel', tone: 'duo' },
  { href: '/galeria', label: 'Registro', full: 'Registro', tone: 'duo' },
  { href: '/contacto', label: 'Contacto', full: 'Contacto', tone: 'duo' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="pz-header">
  <div class="pz-header__inner pz-container">
    <a href="/" class="pz-header__brand" aria-label="Cátedra Zachin — Inicio">
      <img src="/images/logo-iso-white-bold.svg" alt="Cátedra Zachin" class="pz-header__logo pz-header__logo--dark" width="40" height="40" />
      <img src="/images/logo-iso-black-bold.svg" alt="Cátedra Zachin" class="pz-header__logo pz-header__logo--light" width="40" height="40" />
    </a>

    <nav class="pz-header__nav" id="pz-nav" aria-label="Navegación de la propuesta">
      <span class="pz-header__panel" aria-hidden="true"></span>
      <span class="pz-header__sweep" aria-hidden="true"></span>
      <ul class="pz-header__list">
        {nav.map((l, i) => (
          <li class="pz-header__item" style={`--i: ${i}`}>
            <a
              href={l.href}
              class:list={['pz-header__link', `pz-header__link--${l.tone}`, { 'is-active': path === l.href, [`is-active--${l.tone}`]: path === l.href }]}
              aria-current={path === l.href ? 'page' : undefined}
            >
              <svg class="pz-header__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
              <span class="pz-header__label">{l.label}</span>
              <span class="pz-header__label-full">{l.full}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="pz-header__menu-footer">
        <button class="pz-header__theme pz-header__theme--mobile" type="button" aria-label="Cambiar tema claro/oscuro">
          <svg class="pz-theme-svg" viewBox="0 0 32 32" fill="currentColor" stroke-linecap="round" aria-hidden="true">
            <clipPath id="pz-theme-clip-m">
              <path class="toggle__clip-path" d="M0-5h30a1 1 0 0 0 9 13v24H0Z" />
            </clipPath>
            <g clip-path="url(#pz-theme-clip-m)">
              <circle class="toggle__circle" cx="16" cy="16" r="8" />
              <g class="toggle__rays" stroke="currentColor" stroke-width="1.5">
                <path d="M16 5.5v-4" /><path d="M16 30.5v-4" />
                <path d="M1.5 16h4" /><path d="M26.5 16h4" />
                <path d="m23.4 8.6 2.8-2.8" /><path d="m5.7 26.3 2.9-2.9" />
                <path d="m5.8 5.8 2.8 2.8" /><path d="m23.4 23.4 2.9 2.9" />
              </g>
            </g>
          </svg>
        </button>
      </div>
    </nav>

    <div class="pz-header__actions">
      <button class="pz-header__theme pz-header__theme--desktop" type="button" aria-label="Cambiar tema claro/oscuro">
        <svg class="pz-theme-svg" viewBox="0 0 32 32" fill="currentColor" stroke-linecap="round" aria-hidden="true">
          <clipPath id="pz-theme-clip-d">
            <path class="toggle__clip-path" d="M0-5h30a1 1 0 0 0 9 13v24H0Z" />
          </clipPath>
          <g clip-path="url(#pz-theme-clip-d)">
            <circle class="toggle__circle" cx="16" cy="16" r="8" />
            <g class="toggle__rays" stroke="currentColor" stroke-width="1.5">
              <path d="M16 5.5v-4" /><path d="M16 30.5v-4" />
              <path d="M1.5 16h4" /><path d="M26.5 16h4" />
              <path d="m23.4 8.6 2.8-2.8" /><path d="m5.7 26.3 2.9-2.9" />
              <path d="m5.8 5.8 2.8 2.8" /><path d="m23.4 23.4 2.9 2.9" />
            </g>
          </g>
        </svg>
      </button>
      <button class="pz-header__burger" id="pz-burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="pz-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .pz-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 100;
    height: var(--pz-header-height);
    background: var(--pz-bg);
  }
  /* Divisor inferior al ancho del contenido (no full-bleed) */
  .pz-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: calc(min(100%, var(--pz-max-width)) - 2 * var(--pz-container-pad));
    height: var(--pz-border-width);
    background: var(--pz-fg);
  }
  /* Con el menú abierto se oculta: la línea que baja (sweep) ES este divider. */
  .pz-header.is-menu-open::after { opacity: 0; }

  .pz-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--pz-space-lg);
  }

  .pz-header__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .pz-header__logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    transition: transform var(--pz-transition-slow);
  }
  .pz-header__brand:hover .pz-header__logo { transform: rotate(-12deg) scale(1.08); }
  :global([data-theme='dark']) .pz-header__logo--dark { display: block; }
  :global([data-theme='dark']) .pz-header__logo--light { display: none; }
  :global([data-theme='light']) .pz-header__logo--dark { display: none; }
  :global([data-theme='light']) .pz-header__logo--light { display: block; }

  /* Nav: chips con fill en el active (como los tags de galería) */
  .pz-header__nav { align-self: center; }
  .pz-header__list { display: flex; gap: var(--pz-space-sm); align-items: center; }
  .pz-header__item { display: flex; }

  .pz-header__link {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.32rem var(--pz-space-sm);
    border: var(--pz-border-width) solid transparent;
    border-radius: var(--pz-radius);
    /* padding-box: el fill activo no se pinta bajo el borde transparente →
       sin fringe oscuro en las esquinas. */
    background-clip: padding-box;
    font-family: var(--pz-font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pz-muted);
    transition: background var(--pz-transition), color var(--pz-transition);
  }

  /* Hover neutro (calmo) — el fill de color queda reservado al active */
  .pz-header__link:hover { background: var(--pz-surface); color: var(--pz-fg); }

  /* Active: fill tipo tag según el nivel; texto blanco por defecto */
  .pz-header__link.is-active { color: #fff; }
  .pz-header__link.is-active--n1 { background: var(--pz-n1); }
  .pz-header__link.is-active--n2 { background: var(--pz-n2); }
  .pz-header__link.is-active--duo { background: var(--pz-duo); }

  /* Contraste AA: donde el blanco no llega, texto oscuro.
     Claro: cyan (n2) es claro → texto negro. Oscuro: --pz-fg es blanco,
     así que los fills saturados llevan negro explícito. */
  :global([data-theme='light']) .pz-header__link.is-active--n2 { color: #000; }
  :global([data-theme='dark']) .pz-header__link.is-active--n1,
  :global([data-theme='dark']) .pz-header__link.is-active--n2,
  :global([data-theme='dark']) .pz-header__link.is-active--duo { color: #000; }

  /* Flecha, label completo, sweep, plano y footer del menú: sólo mobile */
  .pz-header__arrow { display: none; }
  .pz-header__label-full { display: none; }
  .pz-header__sweep { display: none; }
  .pz-header__panel { display: none; }
  .pz-header__menu-eyebrow { display: none; }
  .pz-header__menu-footer { display: none; }
  .pz-header__theme--mobile { display: none; }

  .pz-header__actions { display: flex; align-items: center; gap: var(--pz-space-xs); }

  .pz-header__theme {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    transition: background var(--pz-transition);
    flex-shrink: 0;
  }
  .pz-header__theme:hover { background: var(--pz-surface); }

  /* Toggle sol/luna (clipPath animado, del sitio original) */
  .pz-theme-svg { width: 1.3rem; height: 1.3rem; color: var(--pz-fg); }
  .toggle__clip-path { transition: transform 0.35s ease-in-out; }
  :global([data-theme='dark']) .toggle__clip-path { transform: translate(-12px, 10px); }
  .toggle__circle { transition: transform 0.35s ease-in-out; transform-origin: 16px 16px; }
  :global([data-theme='dark']) .toggle__circle { transform: scale(1.25); }
  .toggle__rays {
    transition: transform 0.35s ease-in-out, opacity 0.35s ease-in-out;
    transform-origin: 16px 16px;
  }
  :global([data-theme='dark']) .toggle__rays { transform: rotate(-100deg) scale(0.5); opacity: 0; }

  .pz-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
  }
  /* Líneas anchas y centradas; display:block para que Safari las dibuje */
  .pz-header__burger span {
    display: block;
    width: 1.6rem;
    height: var(--pz-border-width);
    background: var(--pz-fg);
    border-radius: 2px;
    transition: transform var(--pz-transition), opacity var(--pz-transition);
  }
  /* X centrada: distancia centro a centro = grosor de línea + gap (6px) */
  .pz-header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(calc(var(--pz-border-width) + 6px)) rotate(45deg); }
  .pz-header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .pz-header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(calc(-1 * (var(--pz-border-width) + 6px))) rotate(-45deg); }

  /* ===========================
     Mobile: menú fullscreen slide-in (estilo del sitio original)
     =========================== */
  @media (max-width: 860px) {
    .pz-header__burger { display: flex; }
    .pz-header__theme--desktop { display: none; }
    .pz-header__theme--mobile { display: grid; }

    /* El overlay cubre top:0; el logo y el burger/X deben quedar por encima
       (dentro del stacking context del header, el nav z:99 los taparía). */
    .pz-header__brand,
    .pz-header__actions { position: relative; z-index: 100; }

    /* Cortina invertida: el nav es un STAGE transparente. La revelación la hace
       un plano color --pz-fg que baja (su borde inferior = la línea), y un
       relleno full-bleed (::before) que recién aparece al final para cubrir los
       márgenes laterales. Sin crossfade: sólo se togglea visibility al instante.
       El texto/íconos del menú se invierten a --pz-bg. */
    .pz-header__nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      align-self: stretch;
      margin: 0;
      z-index: 99;
      background: transparent;
      display: flex;
      flex-direction: column;
      padding:
        calc(var(--pz-header-height) + env(safe-area-inset-top) + var(--pz-space-lg))
        calc(var(--pz-space-lg) + env(safe-area-inset-right))
        calc(var(--pz-space-lg) + env(safe-area-inset-bottom))
        calc(var(--pz-space-lg) + env(safe-area-inset-left));
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      visibility: hidden;
      pointer-events: none;
    }
    .pz-header__nav.is-open,
    .pz-header__nav.is-closing { visibility: visible; }
    .pz-header__nav.is-open { pointer-events: auto; }

    /* Relleno de márgenes laterales (full-bleed): transparente durante la bajada,
       aparece rápido cuando la línea aterriza; en el cierre se va antes del retract. */
    .pz-header__nav::before {
      content: '';
      position: absolute;
      top: calc(var(--pz-header-height) + env(safe-area-inset-top)); /* deja la barra del header intacta arriba */
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 1;
      background: var(--pz-bg);
      opacity: 0;
      pointer-events: none;
    }
    .pz-header__nav.is-open::before {
      opacity: 1;
      transition: opacity 0.1s cubic-bezier(0.4, 0, 0.2, 1) 0.36s;
    }
    .pz-header__nav.is-closing::before {
      opacity: 0;
      transition: opacity 0.1s cubic-bezier(0.4, 0, 1, 1) 0.3s;
    }

    /* Plano content-width que baja (borde inferior = la línea). scaleY desde arriba;
       su alto = el recorrido medido, así el borde inferior y la línea van juntos. */
    .pz-header__panel {
      display: block;
      position: absolute;
      top: calc(var(--pz-header-height) + env(safe-area-inset-top));
      left: calc(var(--pz-space-lg) + env(safe-area-inset-left));
      right: calc(var(--pz-space-lg) + env(safe-area-inset-right));
      height: var(--pz-sweep-travel, calc(100dvh - var(--pz-header-height) - 6rem));
      background: var(--pz-bg);
      transform-origin: top center;
      transform: scaleY(0);
      z-index: 2;
      pointer-events: none;
    }
    .pz-header__nav.is-open .pz-header__panel {
      transform: scaleY(1);
      transition: transform 0.36s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .pz-header__nav.is-closing .pz-header__panel {
      transform: scaleY(0);
      transition: transform 0.32s cubic-bezier(0.5, 0, 0.75, 0) 0.4s;
    }

    /* La MISMA línea: baja hasta el footer y sube al cerrar (nunca se fadea). */
    .pz-header__sweep {
      display: block;
      position: absolute;
      top: calc(var(--pz-header-height) + env(safe-area-inset-top));
      left: calc(var(--pz-space-lg) + env(safe-area-inset-left));
      right: calc(var(--pz-space-lg) + env(safe-area-inset-right));
      height: var(--pz-border-width);
      background: var(--pz-fg);
      z-index: 3;
      transform: translateY(0);
    }
    .pz-header__nav.is-open .pz-header__sweep {
      transform: translateY(var(--pz-sweep-travel, calc(100dvh - var(--pz-header-height) - 6rem)));
      transition: transform 0.36s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .pz-header__nav.is-closing .pz-header__sweep {
      transform: translateY(0);
      transition: transform 0.32s cubic-bezier(0.5, 0, 0.75, 0) 0.4s;
    }

    .pz-header__list {
      position: relative;
      z-index: 4; /* por encima del plano (2) y la línea (3) */
      flex-direction: column;
      gap: var(--pz-space-xs);
      height: auto;
      align-items: stretch;
      /* sin flex:1 → la lista se ancla arriba, no flota centrada */
    }

    /* Entrada escalonada: arranca cuando el plano ya bajó y los márgenes se llenaron */
    .pz-header__item {
      opacity: 0;
      transform: translateX(30px);
    }
    .pz-header__nav.is-open .pz-header__item {
      animation: pzMenuIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(0.42s + var(--i) * 0.04s);
    }
    @keyframes pzMenuIn {
      from { opacity: 0; transform: translateX(30px); }
      to { opacity: 1; transform: translateX(0); }
    }
    /* Salida en cascada inversa: el último item se va primero, acelerando. */
    .pz-header__nav.is-closing .pz-header__item {
      opacity: 1;
      transform: translateX(0);
      animation: pzMenuOut 0.2s cubic-bezier(0.4, 0, 1, 1) forwards;
      animation-delay: calc((4 - var(--i)) * 0.035s);
    }
    @keyframes pzMenuOut {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(24px); }
    }
    /* Sin fondo en hover dentro del menú mobile (el "plano" de hover molesta y
       se queda pegado en touch). */
    .pz-header__link:hover { background: transparent; }

    .pz-header__link {
      gap: var(--pz-space-sm);
      align-items: center;
      min-height: 56px; /* target táctil cómodo */
      font-size: clamp(1.5rem, 7vw, 2.3rem);
      letter-spacing: 0.01em; /* mono grande: tracking ajustado */
      color: var(--pz-fg); /* texto sobre el plano --pz-bg */
      padding: var(--pz-space-xs) 0;
      border: none;
      border-radius: 0;
    }
    /* Color de acento por item (feed de la flecha del activo) */
    .pz-header__link--n1 { --_tone: var(--pz-n1); }
    .pz-header__link--n2 { --_tone: var(--pz-n2); }
    .pz-header__link--duo { --_tone: var(--pz-duo); }

    /* Etiqueta: en mobile el nombre completo (se corre para hacerle lugar a la flecha) */
    .pz-header__label { display: none; }
    .pz-header__label-full {
      display: block;
      transform: translateX(calc(-1.3rem - var(--pz-space-sm)));
      transition: transform 0.3s ease-out;
    }

    /* Anula el fill de chip del desktop en mobile (sin fill → texto en --pz-fg,
       no el #000 que usa el chip lleno; si no, el activo queda negro sobre negro). */
    .pz-header__link.is-active--n1,
    .pz-header__link.is-active--n2,
    .pz-header__link.is-active--duo { background: transparent; color: var(--pz-fg); }
    :global([data-theme='dark']) .pz-header__link.is-active--n1,
    :global([data-theme='dark']) .pz-header__link.is-active--n2,
    :global([data-theme='dark']) .pz-header__link.is-active--duo { color: var(--pz-fg); }

    /* Flecha con reveal en hover/activo (como estaba): entra desde la izquierda. */
    .pz-header__arrow {
      display: block;
      width: 1.3rem;
      height: 1.3rem;
      flex-shrink: 0;
      color: var(--pz-muted);
      opacity: 0;
      transform: translateX(-120%);
      transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    }
    .pz-header__link:hover .pz-header__arrow,
    .pz-header__link.is-active .pz-header__arrow { opacity: 1; transform: translateX(0); }
    .pz-header__link:hover .pz-header__label-full,
    .pz-header__link.is-active .pz-header__label-full { transform: translateX(0); }
    .pz-header__link.is-active .pz-header__arrow { color: var(--pz-fg); }

    .pz-header__menu-footer {
      position: relative;
      z-index: 5; /* el toggle queda por encima del divider (línea) */
      display: flex;
      align-items: center;
      margin-top: auto;
      padding-top: var(--pz-space-lg);
      padding-bottom: var(--pz-space-lg); /* separa el toggle de la línea que aterriza debajo */
      opacity: 0;
      transform: translateX(30px);
    }
    /* El toggle entra DESPUÉS de los links (índice 5) y al cerrar sale PRIMERO. */
    .pz-header__nav.is-open .pz-header__menu-footer {
      animation: pzMenuIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(0.42s + 5 * 0.04s);
    }
    .pz-header__nav.is-closing .pz-header__menu-footer {
      opacity: 1;
      transform: translateX(0);
      animation: pzMenuOut 0.2s cubic-bezier(0.4, 0, 1, 1) forwards;
      animation-delay: 0s;
    }
    .pz-header__theme--mobile { width: 2.75rem; height: 2.75rem; }
    .pz-header__theme--mobile .pz-theme-svg { width: 1.6rem; height: 1.6rem; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Defensa: si un swap ocurrió con el body bloqueado, restaurarlo.
    if (document.body.style.position === 'fixed') {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
    }
    const burger = document.getElementById('pz-burger');
    const nav = document.getElementById('pz-nav');

    if (burger && nav) {
      let scrollY = 0;
      // Bloqueo de scroll del body (técnica iOS: position:fixed + restaurar).
      // Mantiene scrollY=0 mientras el menú está abierto y evita el rubber-band.
      const lock = () => {
        scrollY = window.scrollY;
        const b = document.body.style;
        b.position = 'fixed';
        b.top = `-${scrollY}px`;
        b.left = '0';
        b.right = '0';
        b.width = '100%';
      };
      const unlock = () => {
        const b = document.body.style;
        b.position = '';
        b.top = '';
        b.left = '';
        b.right = '';
        b.width = '';
        window.scrollTo(0, scrollY);
      };
      const sweep = nav.querySelector('.pz-header__sweep');
      const footer = nav.querySelector('.pz-header__menu-footer');
      // Mide cuánto baja la línea para aterrizar DEBAJO del toggle (el toggle
      // queda por encima del divider).
      const setSweepTravel = () => {
        if (!sweep || !footer) return;
        const travel = footer.getBoundingClientRect().bottom - sweep.getBoundingClientRect().top;
        if (travel > 0) nav.style.setProperty('--pz-sweep-travel', `${travel}px`);
      };
      let closeTimer;
      const CLOSE_MS = 730; // ventana del cierre (cascada→fill-out→retract): unlock al final
      const header = nav.closest('.pz-header');
      const open = () => {
        clearTimeout(closeTimer);
        nav.classList.remove('is-closing');
        setSweepTravel(); // medir antes de animar (recorrido exacto)
        nav.classList.add('is-open');
        // El divider del header se oculta: la MISMA línea (sweep) baja desde su
        // posición y vuelve. Así no quedan dos líneas.
        if (header) header.classList.add('is-menu-open');
        burger.setAttribute('aria-expanded', 'true');
        lock();
      };
      const close = () => {
        if (!nav.classList.contains('is-open')) return;
        nav.classList.remove('is-open');
        nav.classList.add('is-closing'); // dispara la salida (cascada inversa + retracción)
        burger.setAttribute('aria-expanded', 'false');
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          nav.classList.remove('is-closing');
          if (header) header.classList.remove('is-menu-open'); // reaparece cuando la línea volvió
          unlock(); // diferido: el scroll se restaura recién cuando el panel ya se fue
        }, CLOSE_MS);
      };
      burger.addEventListener('click', () => {
        nav.classList.contains('is-open') ? close() : open();
      });
      nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      // Al pasar a desktop, cerrar el menú para que no quede abierto tras un resize
      window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
        if (e.matches) close();
      });
      // Cerrar con Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }

    // Toggle de tema (desktop + mobile comparten la clase)
    document.querySelectorAll('.pz-header__theme').forEach((toggle) =>
      toggle.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme') || 'light';
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
      })
    );
  });
</script>
