---
/**
 * PropuestaFooter — pie brutalista con grilla expuesta.
 */
const year = 2026; // fijo: Date no disponible en algunos entornos de build
---

<footer class="pz-footer">
  <div class="pz-container">
    <div class="pz-footer__grid">
      <div class="pz-footer__brand">
        <p class="pz-footer__mark">
          <img src="/images/logo-iso-white-bold.svg" alt="" class="pz-footer__logo pz-footer__logo--dark" width="28" height="28" />
          <img src="/images/logo-iso-black-bold.svg" alt="" class="pz-footer__logo pz-footer__logo--light" width="28" height="28" />
          Cátedra Zachin
        </p>
        <p class="pz-footer__tag">Tecnología · Niveles 1 &amp; 2<br />FADU — UBA</p>
      </div>

      <nav class="pz-footer__col" aria-label="Cátedra">
        <h2 class="pz-footer__heading">Cátedra</h2>
        <ul>
          <li><a href="/nivel-1">Nivel 1</a></li>
          <li><a href="/nivel-2">Nivel 2</a></li>
          <li><a href="/equipo">Plantel docente</a></li>
          <li><a href="/galeria">Registro</a></li>
        </ul>
      </nav>

      <div class="pz-footer__col">
        <h2 class="pz-footer__heading">Contacto</h2>
        <ul>
          <li><a href="mailto:cat.zachin@fadu.uba.ar">cat.zachin@fadu.uba.ar</a></li>
          <li><a href="mailto:cat.zachin.tecno1@gmail.com">cat.zachin.tecno1@gmail.com</a></li>
          <li><a href="mailto:cat.zachin.tecno2@gmail.com">cat.zachin.tecno2@gmail.com</a></li>
          <li>
            <a href="https://instagram.com/catedrazachin" class="pz-footer__ig" target="_blank" rel="noopener noreferrer" aria-label="Instagram @catedrazachin">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pz-footer__bottom">
      <span>{year} Cátedra Zachin — FADU UBA</span>
    </div>
  </div>
</footer>

<style>
  .pz-footer {
    position: relative;
    padding-block: var(--pz-space-2xl) var(--pz-space-lg);
    margin-top: var(--pz-space-2xl);
  }
  /* Divisor superior al ancho del contenido (no full-bleed) */
  .pz-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: calc(min(100%, var(--pz-max-width)) - 2 * var(--pz-container-pad));
    height: var(--pz-border-width);
    background: var(--pz-fg);
  }

  .pz-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.4fr;
    gap: var(--pz-space-xl);
  }

  .pz-footer__mark {
    display: flex;
    align-items: center;
    gap: var(--pz-space-xs);
    font-family: var(--pz-font-display);
    font-weight: var(--pz-display-weight);
    font-size: 1.25rem;
    letter-spacing: var(--pz-display-tracking);
  }
  .pz-footer__logo { width: 1.75rem; height: 1.75rem; object-fit: contain; }
  :global([data-theme='dark']) .pz-footer__logo--dark { display: block; }
  :global([data-theme='dark']) .pz-footer__logo--light { display: none; }
  :global([data-theme='light']) .pz-footer__logo--dark { display: none; }
  :global([data-theme='light']) .pz-footer__logo--light { display: block; }
  .pz-footer__tag { color: var(--pz-muted); font-size: 0.85rem; margin-top: var(--pz-space-xs); }

  .pz-footer__heading {
    font-family: var(--pz-font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pz-muted);
    margin-bottom: var(--pz-space-md);
  }

  .pz-footer__col ul { display: flex; flex-direction: column; gap: var(--pz-space-xs); }
  .pz-footer__col a { font-size: 0.9rem; color: var(--pz-fg); }
  .pz-footer__col a:hover { color: var(--pz-accent); }
  .pz-footer__ig { display: inline-flex; align-items: center; }

  .pz-footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--pz-space-xs);
    margin-top: var(--pz-space-xl);
    padding-top: var(--pz-space-md);
    border-top: var(--pz-border-width) solid var(--pz-fg);
    font-family: var(--pz-font-mono);
    font-size: 0.72rem;
    color: var(--pz-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 860px) {
    .pz-footer__grid { grid-template-columns: 1fr 1fr; gap: var(--pz-space-lg); }
  }
  @media (max-width: 480px) {
    .pz-footer__grid { grid-template-columns: 1fr; }
  }
</style>
