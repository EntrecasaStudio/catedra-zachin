---
import { ClientRouter } from 'astro:transitions';
import PropuestaHeader from '../components/propuesta/PropuestaHeader.astro';
import PropuestaFooter from '../components/propuesta/PropuestaFooter.astro';
import StyleSwitcher from '../components/propuesta/StyleSwitcher.astro';
import '../styles/propuesta.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Propuesta brutalista | Cátedra Zachin',
  description = 'Rediseño brutalista de la Cátedra Zachin — tres intensidades conmutables (refined / raw / neo).',
} = Astro.props;
---

<html lang="es" data-theme="light" data-brutalism="refined">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Tema + piel: aplicar antes del paint para evitar flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme') || 'light';
          document.documentElement.setAttribute('data-theme', t);
          var b = localStorage.getItem('pz-brutalism') || 'refined';
          if (['refined', 'raw', 'neo'].indexOf(b) === -1) b = 'refined';
          document.documentElement.setAttribute('data-brutalism', b);
        } catch (e) {}
      })();
    </script>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fuentes: DIN (Typekit) + Inter + Space Mono (skin raw) -->
    <link rel="stylesheet" href="https://use.typekit.net/owv7rck.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <PropuestaHeader />
    <main id="contenido" class="pz-main">
      <slot />
    </main>
    <PropuestaFooter />
    <StyleSwitcher />

    <script>
      // Persistir tema y piel a través de las View Transitions
      document.addEventListener('astro:before-swap', (ev) => {
        const root = document.documentElement;
        const theme = root.getAttribute('data-theme') || 'light';
        const brut = root.getAttribute('data-brutalism') || 'refined';
        ev.newDocument.documentElement.setAttribute('data-theme', theme);
        ev.newDocument.documentElement.setAttribute('data-brutalism', brut);
      });
    </script>
  </body>
</html>

<style>
  .pz-main {
    padding-top: var(--pz-header-height);
    min-height: 60vh;
  }
</style>
