---

<BaseLayout title="Plantel Docente | Cátedra Zachin" description="Conocé al plantel docente de la Cátedra Zachin.">
  <section class="page-header">
    <div class="container">
      <span class="page-header__label">La cátedra</span>
      <h1>Plantel Docente</h1>
      <p class="page-header__desc">Los docentes y ayudantes que componen la cátedra de Tecnología.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="equipo-grid" data-animate-stagger>
        {docentes.map(d => (
          <div class="docente-card">
            <div class="docente-card__avatar">
              {d.foto
                ? <img src={d.foto} alt={d.nombre} />
                : <span class="docente-card__initial">{d.nombre[0]}</span>
              }
            </div>
            <h3 class="docente-card__nombre">{d.nombre}</h3>
            <span class="docente-card__rol">{d.rol}</span>
            <span class:list={['docente-card__nivel', { 'nivel--1': d.nivel === 'Nivel 1', 'nivel--2': d.nivel === 'Nivel 2' }]}>{d.nivel}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
  }

  .page-header__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    margin-top: var(--space-sm);
  }

  .page-header__desc {
    margin-top: var(--space-md);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  .equipo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .docente-card {
    text-align: center;
    padding: var(--space-lg);
  }

  .docente-card__avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    margin: 0 auto var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .docente-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .docente-card__initial {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .docente-card__nombre {
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .docente-card__rol {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    font-weight: 600;
    display: block;
  }

  .docente-card__nivel {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: block;
    margin-top: var(--space-xs);
    font-weight: 600;
  }

  .nivel--1 { color: var(--color-magenta); }
  .nivel--2 { color: var(--color-cyan); }

  @media (max-width: 768px) {
    .equipo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .equipo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
