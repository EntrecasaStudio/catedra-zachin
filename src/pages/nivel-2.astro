---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tecnología 2 | Cátedra Zachin" description="Tecnología 2 - Tecnologías avanzadas de producción gráfica.">
  <section class="page-header">
    <div class="container">
      <span class="page-header__label">Tecnología</span>
      <h1>Tecnología <span class="text-cyan">2</span></h1>
      <p class="page-header__desc">Profundización en tecnologías avanzadas de producción y gestión de proyectos gráficos.</p>
      <a href="mailto:cat.zachin.tecno2@gmail.com" class="page-header__mail">cat.zachin.tecno2@gmail.com</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Programa</h2>
      <div class="programa">
        <div class="programa__item">
          <span class="programa__num">01</span>
          <h3>Producción Editorial</h3>
          <p>Flujo de producción editorial completo. Del original al libro impreso.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">02</span>
          <h3>Packaging</h3>
          <p>Diseño estructural y gráfico de envases. Materiales y procesos.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">03</span>
          <h3>Señalética y Gran Formato</h3>
          <p>Sistemas de señalización. Impresión en gran formato y materialidad.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">04</span>
          <h3>Producción Digital</h3>
          <p>Impresión digital, plotters, CNC. Nuevas tecnologías de producción.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">05</span>
          <h3>Presupuesto y Gestión</h3>
          <p>Cálculo de costos, presupuestos de producción, gestión con proveedores.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">06</span>
          <h3>Proyecto Integrador</h3>
          <p>Proyecto de producción completo integrando todos los contenidos.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 data-animate>Cronograma</h2>
      <div class="timeline" data-animate-stagger>
        <div class="timeline__item">
          <div class="timeline__node"></div>
          <div class="timeline__content">
            <span class="timeline__fecha">Semana 1-2</span>
            <p class="timeline__desc">Introducción y revisión de contenidos Nivel 1</p>
          </div>
        </div>
        <div class="timeline__item">
          <div class="timeline__node"></div>
          <div class="timeline__content">
            <span class="timeline__fecha">Semana 3-5</span>
            <p class="timeline__desc">TP1: Producción editorial</p>
            <span class="timeline__badge">Entrega TP1</span>
          </div>
        </div>
        <div class="timeline__item">
          <div class="timeline__node"></div>
          <div class="timeline__content">
            <span class="timeline__fecha">Semana 6-8</span>
            <p class="timeline__desc">TP2: Packaging</p>
            <span class="timeline__badge">Entrega TP2</span>
          </div>
        </div>
        <div class="timeline__item">
          <div class="timeline__node"></div>
          <div class="timeline__content">
            <span class="timeline__fecha">Semana 9-11</span>
            <p class="timeline__desc">TP3: Señalética y gran formato</p>
            <span class="timeline__badge">Entrega TP3</span>
          </div>
        </div>
        <div class="timeline__item">
          <div class="timeline__node"></div>
          <div class="timeline__content">
            <span class="timeline__fecha">Semana 12-14</span>
            <p class="timeline__desc">Proyecto Integrador Final</p>
            <span class="timeline__badge timeline__badge--final">Entrega Final</span>
          </div>
        </div>
        <div class="timeline__item">
          <div class="timeline__node timeline__node--end"></div>
          <div class="timeline__content">
            <span class="timeline__fecha">Semana 15-16</span>
            <p class="timeline__desc">Entrega final y recuperatorios</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
    
  }

  .page-header__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-cyan);
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    margin-top: var(--space-sm);
  }

  .page-header__desc {
    margin-top: var(--space-md);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  .page-header__mail {
    display: inline-block;
    margin-top: var(--space-md);
    font-weight: 600;
  }

  .programa {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .programa__item {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    position: relative;
  }

  .programa__num {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-cyan);
    opacity: 0.3;
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
  }

  .programa__item h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
  }

  .programa__item p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .timeline {
    margin-top: var(--space-lg);
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }

  .timeline__item {
    position: relative;
    padding-bottom: var(--space-lg);
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__node {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 3px solid var(--color-cyan);
    position: absolute;
    left: -2rem;
    top: 2px;
    z-index: 1;
    flex-shrink: 0;
  }

  .timeline__node--end {
    background: var(--color-cyan);
  }

  .timeline__content {
    padding: var(--space-md) var(--space-lg);
    background: var(--color-surface);
    border-radius: 6px;
    border: 1px solid var(--color-border);
    flex: 1;
  }

  .timeline__fecha {
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .timeline__desc {
    font-size: 0.9375rem;
    margin-top: var(--space-xs);
    color: var(--color-text-secondary);
  }

  .timeline__badge {
    display: inline-block;
    margin-top: var(--space-sm);
    padding: 2px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cyan) 12%, transparent);
    color: var(--color-cyan);
  }

  .timeline__badge--final {
    background: var(--color-cyan);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .programa {
      grid-template-columns: 1fr;
    }

    .timeline {
      padding-left: 1.5rem;
    }

    .timeline__node {
      left: -1.5rem;
      width: 12px;
      height: 12px;
    }

    .timeline::before {
      left: 5px;
    }
  }
</style>
