---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tecnología 2 | Cátedra Zachin" description="Tecnología 2 - Tecnologías avanzadas de producción gráfica.">
  <section class="page-header">
    <div class="container">
      <span class="page-header__label">Tecnología</span>
      <h1>Tecnología <span class="text-cyan">2</span></h1>
      <p class="page-header__desc">Profundización en tecnologías avanzadas de producción y gestión de proyectos gráficos.</p>
      <a href="mailto:cat.zachin.tecno2@gmail.com" class="page-header__mail">cat.zachin.tecno2@gmail.com</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Programa</h2>
      <div class="programa">
        <div class="programa__item">
          <span class="programa__num">01</span>
          <h3>Producción Editorial</h3>
          <p>Flujo de producción editorial completo. Del original al libro impreso.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">02</span>
          <h3>Packaging</h3>
          <p>Diseño estructural y gráfico de envases. Materiales y procesos.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">03</span>
          <h3>Señalética y Gran Formato</h3>
          <p>Sistemas de señalización. Impresión en gran formato y materialidad.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">04</span>
          <h3>Producción Digital</h3>
          <p>Impresión digital, plotters, CNC. Nuevas tecnologías de producción.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">05</span>
          <h3>Presupuesto y Gestión</h3>
          <p>Cálculo de costos, presupuestos de producción, gestión con proveedores.</p>
        </div>
        <div class="programa__item">
          <span class="programa__num">06</span>
          <h3>Proyecto Integrador</h3>
          <p>Proyecto de producción completo integrando todos los contenidos.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Cronograma</h2>
      <div class="cronograma">
        <div class="cronograma__item">
          <span class="cronograma__fecha">Semana 1-2</span>
          <p>Introducción y revisión de contenidos Nivel 1</p>
        </div>
        <div class="cronograma__item">
          <span class="cronograma__fecha">Semana 3-5</span>
          <p>TP1: Producción editorial</p>
        </div>
        <div class="cronograma__item">
          <span class="cronograma__fecha">Semana 6-8</span>
          <p>TP2: Packaging</p>
        </div>
        <div class="cronograma__item">
          <span class="cronograma__fecha">Semana 9-11</span>
          <p>TP3: Señalética y gran formato</p>
        </div>
        <div class="cronograma__item">
          <span class="cronograma__fecha">Semana 12-14</span>
          <p>Proyecto Integrador Final</p>
        </div>
        <div class="cronograma__item">
          <span class="cronograma__fecha">Semana 15-16</span>
          <p>Entrega final y recuperatorios</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
    
  }

  .page-header__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-cyan);
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    margin-top: var(--space-sm);
  }

  .page-header__desc {
    margin-top: var(--space-md);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  .page-header__mail {
    display: inline-block;
    margin-top: var(--space-md);
    font-weight: 600;
  }

  .programa {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .programa__item {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    position: relative;
  }

  .programa__num {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-cyan);
    opacity: 0.3;
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
  }

  .programa__item h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
  }

  .programa__item p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .cronograma {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .cronograma__item {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--color-cyan);
    background-color: var(--color-surface);
  }

  .cronograma__fecha {
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--color-cyan);
    white-space: nowrap;
    min-width: 120px;
  }

  .cronograma__item p {
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .programa {
      grid-template-columns: 1fr;
    }

    .cronograma__item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }
</style>
