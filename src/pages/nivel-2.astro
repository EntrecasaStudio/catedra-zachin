---
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import NivelDetalle from '../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '1', titulo: 'Industria gráfica', desc: 'Panorama de la industria gráfica: producción masiva frente a bajo demanda, sus lógicas y escalas. El traslado digital del original a la máquina (computer-to).' },
  { num: '2', titulo: 'Soportes e insumos', desc: 'El papel y otros soportes (plástico, metal, vidrio), sus características y fabricación. Pigmentos, tintas y su comportamiento en los distintos sistemas de impresión.' },
  { num: '3', titulo: 'Pre-impresión', desc: 'Etapas previas a la impresión: lenguajes de descripción de página (PDL), tramados y semitonos, fotocromía y rango dinámico. Control de calidad del archivo.' },
  { num: '4', titulo: 'Controles de impresión', desc: 'El acto de imprimir: controles de calidad, pie de máquina y aprobación de pliego. Registro, densitometría y variables del proceso.' },
  { num: '5', titulo: 'Postimpresión', desc: 'Terminaciones y acabados que completan la pieza: tratamientos superficiales, cortes, dobleces, packaging y encuadernación.' },
  { num: '6', titulo: 'Gestión de color', desc: 'Perfiles ICC, espacios de color, calibración de dispositivos y flujos de trabajo para garantizar consistencia cromática entre pantalla e impresión.' },
  { num: '7', titulo: 'Productos digitales', desc: 'Los productos digitales como destino de producción: especificaciones, formatos y publicación. Sus diferencias frente a la salida material y su lugar en el flujo de trabajo actual.' },
];

---

<PropuestaLayout title="Tecnología 2 | Propuesta Zachin" description="Tecnología 2 — Tecnologías avanzadas de producción gráfica.">
  <NivelDetalle
    nivel={2}
    desc="La producción del diseño en soporte material: industria gráfica, soportes e insumos, pre-impresión, controles de impresión, postimpresión, gestión de color y productos digitales."
    mail="cat.zachin.tecno2@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:30 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
