---
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import Section from '../components/propuesta/Section.astro';
import Grid from '../components/propuesta/Grid.astro';
import NivelCard from '../components/propuesta/NivelCard.astro';
import HalftoneLab from '../components/propuesta/HalftoneLab.astro';

const explorar = [
  { href: '/equipo', tag: 'Plantel', title: 'Plantel docente', desc: 'Adjuntos, JTP, docentes y ayudantes de la cátedra.' },
  { href: '/galeria', tag: 'Multimedia', title: 'Registro', desc: 'Fotos y videos de clases, talleres y jornadas.' },
];
---

<PropuestaLayout>
  <!-- Hero: fondo halftone (K en claro / RGB en oscuro), tenue, a pantalla completa -->
  <section class="hero" data-hero-halftone>
    <canvas class="hero__bg" aria-hidden="true"></canvas>
    <div class="hero__content pz-container" data-reveal-group>
      <span class="pz-eyebrow" data-reveal>Diseño gráfico | FADU · UBA</span>
      <h1 class="hero__title" data-reveal>Cátedra<br />Zachin</h1>
      <p class="hero__subtitle" data-reveal>Tecnología | Nivel <span class="text-n1">1</span> &amp; <span class="text-n2">2</span></p>
    </div>
  </section>

  <!-- Niveles -->
  <Section>
    <Grid cols={2} colsMd={1} data-reveal-group>
      <NivelCard data-reveal titleHidden nivel={1} title="Tecnología 1" href="/nivel-1" desc="Color, imagen digital, soportes, generación de originales, web e introducción a la industria gráfica." />
      <NivelCard data-reveal titleHidden nivel={2} title="Tecnología 2" href="/nivel-2" desc="Industria gráfica, soportes e insumos, pre-impresión, impresión, postimpresión y productos digitales." />
    </Grid>
  </Section>

  <!-- Halftone Lab: la sección ES el juego interactivo, sin texto -->
  <Section>
    <HalftoneLab brush="both" />
  </Section>

  <!-- Explorar (cards sin imagen, con trama de puntos) -->
  <Section>
    <Grid cols={2} colsMd={1} data-reveal-group>
      {explorar.map((c) => (
        <a class="explore-card" data-reveal href={c.href}>
          <div class="explore-card__head">
            <span class="pz-tag">{c.tag}</span>
            <span class="explore-card__arrow" aria-hidden="true">↗</span>
          </div>
          <div class="explore-card__body">
            <h3 class="explore-card__title">{c.title}</h3>
            <p class="explore-card__desc">{c.desc}</p>
          </div>
        </a>
      ))}
    </Grid>
  </Section>
</PropuestaLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--pz-header-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    opacity: 0.12;
    z-index: 0;
  }
  :global([data-theme='dark']) .hero__bg { opacity: 0.24; }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: var(--pz-space-xl);
  }
  /* Eyebrow + título quedan centrados; la bajada se ancla al fondo del hero
     (arriba del divider) vía márgenes automáticos que reparten el espacio. */
  .hero__content > .pz-eyebrow { margin-top: auto; }
  .hero__title {
    font-size: clamp(3.5rem, 15vw, 10rem);
    line-height: 0.9;
    margin-top: var(--pz-space-md);
  }
  /* Segunda jerarquía reforzada: mono (como la volanta) pero mucho más presente
     —tamaño de subhead, bold, color pleno— con los números en color de nivel.
     Deja de leerse como caption. */
  .hero__subtitle {
    font-family: var(--pz-font-mono);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
    color: var(--pz-fg);
    margin-top: auto; /* se ancla al fondo del hero */
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pz-space-sm);
    margin-top: var(--pz-space-xl);
  }

  /* Explore card: sin imagen, con trama de puntos (halftone) */
  .explore-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--pz-space-xl);
    min-height: 240px;
    padding: var(--pz-space-lg);
    border: var(--pz-border-width) solid var(--pz-fg);
    border-radius: var(--pz-radius);
    box-shadow: var(--pz-shadow);
    background: var(--pz-bg);
    color: var(--pz-fg);
    overflow: hidden;
    transition: transform var(--pz-transition), box-shadow var(--pz-transition);
  }
  .explore-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--pz-fg) 1.4px, transparent 1.5px);
    background-size: 13px 13px;
    opacity: 0.05;
    transition: opacity var(--pz-transition);
    pointer-events: none;
  }
  .explore-card:hover {
    transform: translate(var(--pz-lift), var(--pz-lift));
    box-shadow: var(--pz-shadow-hover);
  }
  .explore-card:hover::before { opacity: 0.12; }

  .explore-card__head {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .explore-card__arrow {
    font-size: 1.9rem;
    line-height: 1;
    transition: transform var(--pz-transition);
  }
  .explore-card:hover .explore-card__arrow { transform: translate(5px, -5px); }

  .explore-card__body { position: relative; }
  .explore-card__title { font-size: clamp(1.6rem, 4vw, 2.4rem); }
  .explore-card__desc {
    color: var(--pz-muted);
    font-size: 0.95rem;
    margin-top: var(--pz-space-md);
    max-width: 34ch;
  }
</style>

<script>
  import { initHalftoneLab } from '../scripts/halftone-lab.js';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-hero-halftone]').forEach((el) => {
      const lab = initHalftoneLab(el, { background: true });
      if (!lab) return;
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => (e.isIntersecting ? lab.start() : lab.stop())),
        { threshold: 0 }
      );
      io.observe(el);
      document.addEventListener('astro:before-swap', () => { io.disconnect(); lab.destroy(); }, { once: true });
    });
  });
</script>
