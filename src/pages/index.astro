        </div>
        <div class="inscripciones__links">
          <a href="#" class="btn btn-nivel1">Inscripción Nivel 1</a>
          <a href="#" class="btn btn-nivel2">Inscripción Nivel 2</a>
        </div>
      </div>

      <div class="inscripciones__mails" data-animate-stagger>
        <div class="mail-card mail-card--general">
          <span class="mail-card__level">General</span>
          <a href="mailto:cat.zachin@fadu.uba.ar">cat.zachin@fadu.uba.ar</a>
        </div>
        <div class="mail-card mail-card--n1">
          <span class="mail-card__level">Nivel 1</span>
          <a href="mailto:cat.zachin.tecno1@gmail.com">cat.zachin.tecno1@gmail.com</a>
        </div>
        <div class="mail-card mail-card--n2">
          <span class="mail-card__level">Nivel 2</span>
          <a href="mailto:cat.zachin.tecno2@gmail.com">cat.zachin.tecno2@gmail.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Niveles Preview -->
