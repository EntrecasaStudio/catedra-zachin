---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__inner container">
      <div class="hero__content">
        <span class="hero__label">FADU - UBA / Diseño Gráfico</span>
        <h1 class="hero__title">
          Cátedra<br/>
          Zachin
        </h1>
        <p class="hero__subtitle">Tecnología / Niveles 1 & 2</p>
        <div class="hero__actions">
          <a href="/contacto" class="btn btn-primary">Inscribite</a>
          <a href="https://instagram.com/catedrazachin" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            @catedrazachin
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Inscripciones Banner -->
  <section class="inscripciones section">
    <div class="container">
      <div class="inscripciones__banner" data-animate>
        <div class="inscripciones__info">
          <h2>Inscripciones Abiertas</h2>
          <p>Primer cuatrimestre 2026 - Nivel 1 y Nivel 2</p>
        </div>
        <div class="inscripciones__links">
          <a href="#" class="btn btn-nivel1">Inscripción Nivel 1</a>
          <a href="#" class="btn btn-nivel2">Inscripción Nivel 2</a>
        </div>
      </div>

      <div class="inscripciones__mails" data-animate-stagger>
        <div class="mail-card mail-card--n1">
          <span class="mail-card__level">Nivel 1</span>
          <a href="mailto:nivel1@catedrazachin.ar">nivel1@catedrazachin.ar</a>
        </div>
        <div class="mail-card mail-card--n2">
          <span class="mail-card__level">Nivel 2</span>
          <a href="mailto:nivel2@catedrazachin.ar">nivel2@catedrazachin.ar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Niveles Preview -->
  <section class="niveles section">
    <div class="container">
      <h2 class="section-title" data-animate>Niveles</h2>
      <div class="niveles__grid" data-animate-stagger>
        <a href="/nivel-1" class="nivel-card nivel-card--n1">
          <span class="nivel-card__number">01</span>
          <h3>Nivel 1</h3>
          <p>Introducción a las tecnologías de producción gráfica. Procesos analógicos y digitales.</p>
          <span class="nivel-card__link">Ver programa &rarr;</span>
        </a>
        <a href="/nivel-2" class="nivel-card nivel-card--n2">
          <span class="nivel-card__number">02</span>
          <h3>Nivel 2</h3>
          <p>Profundización en tecnologías avanzadas de producción y gestión de proyectos gráficos.</p>
          <span class="nivel-card__link">Ver programa &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Secciones Preview -->
  <section class="previews section">
    <div class="container">
      <div class="previews__grid" data-animate-stagger>
        <a href="/equipo" class="preview-card">
          <h3>Equipo Docente</h3>
          <p>Conocé a los docentes y ayudantes de la cátedra.</p>
        </a>
        <a href="/galeria" class="preview-card">
          <h3>Galería</h3>
          <p>Fotos y videos de las clases, eventos y talleres.</p>
        </a>
        <a href="/trabajos" class="preview-card">
          <h3>Trabajos de Alumnos</h3>
          <p>Los mejores trabajos de cuatrimestres anteriores.</p>
        </a>
        <a href="/recursos" class="preview-card">
          <h3>Recursos</h3>
          <p>Tutoriales, software y material de apoyo.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: 80dvh;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    padding-block: var(--space-2xl);
  }

  .hero__label,
  .hero__title,
  .hero__subtitle,
  .hero__actions {
    opacity: 0;
    transform: translateY(20px);
  }

  .hero__title {
    transform: translateY(40px);
  }

  .hero--animated .hero__label {
    animation: heroFadeIn 0.6s ease-out 0.15s forwards;
  }

  .hero--animated .hero__title {
    animation: heroFadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  .hero--animated .hero__subtitle {
    animation: heroFadeIn 0.6s ease-out 0.55s forwards;
  }

  .hero--animated .hero__actions {
    animation: heroFadeIn 0.6s ease-out 0.75s forwards;
  }

  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroFadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: var(--space-md);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    color: var(--color-text-secondary);
    margin-top: var(--space-md);
    font-weight: 500;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }

  /* Inscripciones */
  .inscripciones__banner {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .inscripciones__banner h2 {
    font-size: 1.5rem;
  }

  .inscripciones__banner p {
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }

  .inscripciones__links {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .btn-nivel1 {
    background-color: var(--color-magenta);
    color: var(--color-white);
  }

  .btn-nivel1:hover {
    background-color: #c4006a;
    color: var(--color-white);
  }

  .btn-nivel2 {
    background-color: var(--color-cyan);
    color: var(--color-white);
  }

  .btn-nivel2:hover {
    background-color: #0080b8;
    color: var(--color-white);
  }

  .inscripciones__mails {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .mail-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mail-card__level {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .mail-card--n1 .mail-card__level { color: var(--color-magenta); }
  .mail-card--n2 .mail-card__level { color: var(--color-cyan); }

  .mail-card a {
    font-size: 1rem;
    font-weight: 600;
  }

  /* Section Title */
  .section-title {
    margin-bottom: var(--space-xl);
  }

  /* Niveles */
  .niveles__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .nivel-card {
    display: block;
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .nivel-card:hover {
    color: var(--color-text);
  }

  .nivel-card--n1:hover { border-color: var(--color-magenta); }
  .nivel-card--n2:hover { border-color: var(--color-cyan); }

  .nivel-card__number {
    font-size: 4rem;
    font-weight: 700;
    opacity: 0.2;
    position: absolute;
    top: var(--space-md);
    right: var(--space-lg);
    line-height: 1;
  }

  .nivel-card--n1 .nivel-card__number { color: var(--color-magenta); }
  .nivel-card--n2 .nivel-card__number { color: var(--color-cyan); }

  .nivel-card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .nivel-card p {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  .nivel-card__link {
    display: inline-block;
    margin-top: var(--space-md);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .nivel-card--n1 .nivel-card__link { color: var(--color-magenta); }
  .nivel-card--n2 .nivel-card__link { color: var(--color-cyan); }

  /* Previews Grid */
  .previews__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .preview-card {
    display: block;
    padding: var(--space-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-base);
  }

  .preview-card:hover {
    border-color: var(--color-text-secondary);
    color: var(--color-text);
  }

  .preview-card h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
  }

  .preview-card p {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .inscripciones__mails,
    .niveles__grid {
      grid-template-columns: 1fr;
    }

    .previews__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .previews__grid {
      grid-template-columns: 1fr;
    }

    .inscripciones__banner {
      flex-direction: column;
      text-align: center;
    }

    .inscripciones__links {
      justify-content: center;
    }
  }
</style>
