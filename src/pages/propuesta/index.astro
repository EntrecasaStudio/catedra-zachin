---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import Section from '../../components/propuesta/Section.astro';
import Grid from '../../components/propuesta/Grid.astro';
import Button from '../../components/propuesta/Button.astro';
import NivelCard from '../../components/propuesta/NivelCard.astro';
import HalftoneLab from '../../components/propuesta/HalftoneLab.astro';
import Card from '../../components/propuesta/Card.astro';
import Slideshow from '../../components/propuesta/Slideshow.astro';

const plantel = [
  { src: '/images/docentes/Adjunta-Daniela-Vulcano.png', alt: 'Plantel docente' },
  { src: '/images/docentes/Adjunto-Leandro-Barales.png', alt: 'Plantel docente' },
  { src: '/images/docentes/DOCENTE-Juan-Hileger.png', alt: 'Plantel docente' },
  { src: '/images/docentes/DOCENTE-Catalina-Somoza.png', alt: 'Plantel docente' },
];
const galeria = [
  { src: '/images/galeria/jornada/IMG_1481.jpg', alt: 'Jornada Zachin Live' },
  { src: '/images/galeria/clase/IMG_4048.jpg', alt: 'Clase de tecnología' },
  { src: '/images/galeria/taller/IMG_2825.jpg', alt: 'Taller de producción' },
];
---

<PropuestaLayout>
  <!-- Hero -->
  <section class="hero pz-container">
    <span class="pz-eyebrow">FADU · UBA / Diseño Gráfico</span>
    <h1 class="hero__title">Cátedra<br />Zachin</h1>
    <p class="hero__subtitle">Tecnología — Niveles 1 &amp; 2</p>
    <div class="hero__actions">
      <Button href="https://instagram.com/catedrazachin" variant="secondary" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
        </svg>
        @catedrazachin
      </Button>
    </div>
  </section>

  <!-- Niveles -->
  <Section eyebrow="Programa" title="Dos niveles, un sistema" lead="De la reproducción del diseño (digital y web) a la replicación del diseño material (industria gráfica e impresión).">
    <Grid cols={2} colsMd={1}>
      <NivelCard nivel={1} title="Tecnología 1" href="/propuesta/nivel-1" desc="Color, imagen digital, soportes, generación de originales, web e introducción a la industria gráfica." />
      <NivelCard nivel={2} title="Tecnología 2" href="/propuesta/nivel-2" desc="Industria gráfica, soportes e insumos, pre-impresión, impresión y postimpresión." />
    </Grid>
  </Section>

  <!-- Halftone Lab: la sección ES el juego interactivo, sin texto -->
  <Section>
    <HalftoneLab />
  </Section>

  <!-- Explorar -->
  <Section eyebrow="Explorar" title="Adentro de la cátedra">
    <Grid cols={2} colsMd={1}>
      <Card href="/propuesta/equipo">
        <Slideshow slot="media" images={plantel} offset={0} />
        <h3 class="pz-card__title">Plantel docente</h3>
        <p class="pz-card__text">Adjuntos, JTP, docentes y ayudantes de la cátedra.</p>
      </Card>
      <Card href="/propuesta/galeria">
        <Slideshow slot="media" images={galeria} offset={1500} />
        <h3 class="pz-card__title">Galería</h3>
        <p class="pz-card__text">Fotos y videos de clases, talleres y jornadas.</p>
      </Card>
    </Grid>
  </Section>
</PropuestaLayout>

<style>
  .hero {
    /* Full viewport: el hero llena la pantalla y el divisor de la sección
       siguiente queda justo en el borde inferior. */
    min-height: calc(100dvh - var(--pz-header-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--pz-space-2xl);
  }
  .hero__title {
    font-size: clamp(3.5rem, 15vw, 10rem);
    line-height: 0.9;
    margin-top: var(--pz-space-md);
  }
  .hero__subtitle {
    font-size: clamp(1.1rem, 3vw, 1.75rem);
    color: var(--pz-muted);
    margin-top: var(--pz-space-md);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pz-space-sm);
    margin-top: var(--pz-space-xl);
  }
</style>
