---
/**
 * Ruta de test (temporal) — Brush variante B: "área + intensidad".
 * Mantener presionado agranda el radio del brush y además sube el tamaño máximo
 * del punto, dejando un tono más denso donde se sostiene. Se compara contra
 * /propuesta/test-brush-a.
 */
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import Section from '../../components/propuesta/Section.astro';
import HalftoneLab from '../../components/propuesta/HalftoneLab.astro';
---

<PropuestaLayout title="Test brush B (área + intensidad) | Propuesta Zachin" description="Prueba de brush del experimento — variante área + intensidad.">
  <section class="tb-hero pz-container" data-reveal-group>
    <span class="pz-eyebrow" data-reveal>Test · variante B</span>
    <h1 class="tb-hero__title" data-reveal>Brush: área + intensidad</h1>
    <p class="tb-hero__desc" data-reveal>
      Mantené presionado el mouse: el brush crece de tamaño y además el tono se
      vuelve más denso donde lo sostenés. Lo pintado queda fijo al soltar.
    </p>
  </section>

  <Section>
    <HalftoneLab id="halftone-test-b" brush="both" />
  </Section>
</PropuestaLayout>

<style>
  .tb-hero { padding-block: clamp(2.5rem, 8vh, 5rem) var(--pz-space-xl); }
  .tb-hero__title { font-size: clamp(2.5rem, 10vw, 6rem); margin-top: var(--pz-space-sm); }
  .tb-hero__desc { color: var(--pz-muted); font-size: 1.1rem; margin-top: var(--pz-space-md); max-width: 60ch; }
</style>
