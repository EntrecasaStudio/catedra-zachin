---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Industria Gráfica', desc: 'Reproducción masiva y bajo demanda. Traslado digital (concepto computer-to).' },
  { num: '02', titulo: 'Soportes e Insumos', desc: 'Papel: características y fabricación. Otros soportes: plástico, metal, vidrio. Pigmentos y tintas.' },
  { num: '03', titulo: 'Pre-impresión', desc: 'Lenguaje de transmisión de datos (PDL). Transformaciones, tramados, fotocromía y rango dinámico.' },
  { num: '04', titulo: 'Impresión', desc: 'Controles, pie de máquina y aprobación de pliego. Sistemas en relieve, superficie, profundidad, híbridos y digitales. Impresión bajo demanda.' },
  { num: '05', titulo: 'Postimpresión', desc: 'Impresiones especiales, tratamientos superficiales, cortes y dobleces. Packaging y encuadernación.' },
];

---

<PropuestaLayout title="Tecnología 2 | Propuesta Zachin" description="Tecnología 2 — Tecnologías avanzadas de producción gráfica.">
  <NivelDetalle
    nivel={2}
    desc="Replicación del diseño material: industria gráfica, soportes e insumos, pre-impresión, impresión y postimpresión."
    mail="cat.zachin.tecno2@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
