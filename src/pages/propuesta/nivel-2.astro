---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Original gráfico y dos tintas', desc: 'Diseño de original a dos tintas; preparación del original gráfico y formatos de archivo.' },
  { num: '02', titulo: 'Industria gráfica', desc: 'Reproducción masiva y bajo demanda; traslado digital (concepto computer-to).' },
  { num: '03', titulo: 'Pre-impresión', desc: 'Tramados y medición de lineaturas.' },
  { num: '04', titulo: 'Post-impresión', desc: 'Tratamientos superficiales, cortes, dobleces, packaging y encuadernación.' },
  { num: '05', titulo: 'Papel y soportes', desc: 'Características y fabricación del papel; otros soportes de producción.' },
  { num: '06', titulo: 'Productos digitales y web', desc: 'Los productos digitales y la web como destino de producción.' },
  { num: '07', titulo: 'Gestión de color', desc: 'Gestión de color en el flujo de producción gráfica.' },
];

---

<PropuestaLayout title="Tecnología 2 | Propuesta Zachin" description="Tecnología 2 — Tecnologías avanzadas de producción gráfica.">
  <NivelDetalle
    nivel={2}
    desc="Replicación del diseño material: industria gráfica, archivos, pre y post-impresión, papel, productos digitales y gestión de color."
    mail="cat.zachin.tecno2@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
