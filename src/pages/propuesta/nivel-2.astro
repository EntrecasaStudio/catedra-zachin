---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Producción Editorial', desc: 'Flujo de producción editorial completo. Del original al libro impreso.' },
  { num: '02', titulo: 'Packaging', desc: 'Diseño estructural y gráfico de envases. Materiales y procesos.' },
  { num: '03', titulo: 'Señalética y Gran Formato', desc: 'Sistemas de señalización. Impresión en gran formato y materialidad.' },
  { num: '04', titulo: 'Producción Digital', desc: 'Impresión digital, plotters, CNC. Nuevas tecnologías de producción.' },
  { num: '05', titulo: 'Presupuesto y Gestión', desc: 'Cálculo de costos, presupuestos de producción, gestión con proveedores.' },
  { num: '06', titulo: 'Proyecto Integrador', desc: 'Proyecto de producción completo integrando todos los contenidos.' },
];

const cronograma = [
  { fecha: 'Semana 1-2', desc: 'Introducción y revisión de contenidos Nivel 1' },
  { fecha: 'Semana 3-5', desc: 'TP1: Producción editorial', badge: 'Entrega TP1' },
  { fecha: 'Semana 6-8', desc: 'TP2: Packaging', badge: 'Entrega TP2' },
  { fecha: 'Semana 9-11', desc: 'TP3: Señalética y gran formato', badge: 'Entrega TP3' },
  { fecha: 'Semana 12-14', desc: 'Proyecto Integrador Final', badge: 'Entrega Final', final: true },
  { fecha: 'Semana 15-16', desc: 'Entrega final y recuperatorios' },
];
---

<PropuestaLayout title="Tecnología 2 | Propuesta Zachin" description="Tecnología 2 — Tecnologías avanzadas de producción gráfica.">
  <NivelDetalle
    nivel={2}
    desc="Profundización en tecnologías avanzadas de producción y gestión de proyectos gráficos."
    mail="cat.zachin.tecno2@gmail.com"
    programa={programa}
    cronograma={cronograma}
  />
</PropuestaLayout>
