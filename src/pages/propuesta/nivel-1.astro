---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Color', desc: 'Teoría y principios de formación del color para gráfica virtual y material (RGB, CMYK, hexadecimal, Lab). Espacio, modelo y gama.' },
  { num: '02', titulo: 'Tecnología y Diseño', desc: 'La producción del objeto de diseño y el rol del diseñador. Flujo de trabajo, estandarización, sustentabilidad, dispositivos y software.' },
  { num: '03', titulo: 'La Imagen Digital', desc: 'Tipos de imágenes: obtención, generación y aplicación. Imagen pixelar y vectorial. Archivos de fuentes tipográficas.' },
  { num: '04', titulo: 'Soportes Digitales', desc: 'Dispositivos y características: formación de imagen, resoluciones de pantalla. Diseño responsivo (adaptabilidad).' },
  { num: '05', titulo: 'Generación Digital de Originales', desc: 'Destino virtual y material. Almacenamiento y traslado digital. Archivos y formatos. Periféricos de entrada y salida. Uso de fuentes.' },
  { num: '06', titulo: 'Web', desc: 'Estándares, lenguajes e hipertexto. Interfaces, usabilidad y experiencia de usuario.' },
  { num: '07', titulo: 'Introducción a la Industria Gráfica', desc: 'Reproducción masiva de piezas materiales. Introducción a los procesos de impresión convencional y digital.' },
];

---

<PropuestaLayout title="Tecnología 1 | Propuesta Zachin" description="Tecnología 1 — Introducción a los procesos de producción gráfica.">
  <NivelDetalle
    nivel={1}
    desc="Reproducción del diseño: color, imagen digital, soportes, generación de originales, web e introducción a la industria gráfica."
    mail="cat.zachin.tecno1@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
