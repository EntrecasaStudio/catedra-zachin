---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Introducción a la Tecnología Gráfica', desc: 'Conceptos fundamentales de producción gráfica. Flujo de trabajo general.' },
  { num: '02', titulo: 'Sistemas de Impresión', desc: 'Offset, serigrafía, tipografía, flexografía, huecograbado. Procesos y aplicaciones.' },
  { num: '03', titulo: 'Preimpresión Digital', desc: 'Preparación de archivos, perfiles de color, resolución, trapping.' },
  { num: '04', titulo: 'Papeles y Soportes', desc: 'Tipos de papel, gramaje, texturas. Elección de soporte según el proyecto.' },
  { num: '05', titulo: 'Terminación y Postimpresión', desc: 'Troquelado, laminado, barnizado, encuadernación. Acabados especiales.' },
  { num: '06', titulo: 'Color', desc: 'Teoría del color aplicada. CMYK, RGB, Pantone. Gestión de color.' },
];

const cronograma = [
  { fecha: 'Semana 1-2', desc: 'Introducción y diagnóstico' },
  { fecha: 'Semana 3-5', desc: 'TP1: Sistemas de impresión', badge: 'Entrega TP1' },
  { fecha: 'Semana 6-8', desc: 'TP2: Preimpresión y color', badge: 'Entrega TP2' },
  { fecha: 'Semana 9-11', desc: 'TP3: Papeles y terminación', badge: 'Entrega TP3' },
  { fecha: 'Semana 12-14', desc: 'Trabajo Final Integrador', badge: 'Entrega Final', final: true },
  { fecha: 'Semana 15-16', desc: 'Entrega final y recuperatorios' },
];
---

<PropuestaLayout title="Tecnología 1 | Propuesta Zachin" description="Tecnología 1 — Introducción a los procesos de producción gráfica.">
  <NivelDetalle
    nivel={1}
    desc="Introducción a las tecnologías de producción gráfica. Procesos analógicos y digitales."
    mail="cat.zachin.tecno1@gmail.com"
    programa={programa}
    cronograma={cronograma}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
