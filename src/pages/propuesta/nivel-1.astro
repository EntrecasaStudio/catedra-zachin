---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Color', desc: 'Cómo se forma y se percibe el color en gráfica virtual y material. Síntesis aditiva y sustractiva, los modelos RGB, CMYK y hexadecimal, y la correspondencia entre el color de pantalla y el color de impresión.' },
  { num: '02', titulo: 'Imagen digital y web', desc: 'Naturaleza de la imagen digital: mapa de bits (pixelar) frente a vectorial, resolución, modos y modelos de imagen. Fundamentos de la web como soporte —estándares y lenguajes— y su relación con la producción gráfica.' },
  { num: '03', titulo: 'Generación de originales', desc: 'Producción digital de originales listos para reproducir, para destino virtual y material. Preparación del archivo, criterios de calidad y adecuación de la pieza a cada sistema de salida.' },
  { num: '04', titulo: 'Papel y computer-to-plate', desc: 'El papel como soporte: tipos, características y proceso de fabricación. El flujo computer-to-plate (CTP) como puente entre el original digital y la matriz de impresión.' },
  { num: '05', titulo: 'Sistemas de impresión', desc: 'Las familias de sistemas según cómo transfieren la tinta: relieve (flexografía), profundidad (rotograbado), planográfica (offset), permeográfica (serigrafía) e híbridos y digitales. Criterios para elegir el sistema según la pieza.' },
];

---

<PropuestaLayout title="Tecnología 1 | Propuesta Zachin" description="Tecnología 1 — Introducción a los procesos de producción gráfica.">
  <NivelDetalle
    nivel={1}
    desc="Reproducción del diseño: color, imagen digital y web, generación de originales, papel y los sistemas de impresión (flexografía, rotograbado, offset, serigrafía e híbridos)."
    mail="cat.zachin.tecno1@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
