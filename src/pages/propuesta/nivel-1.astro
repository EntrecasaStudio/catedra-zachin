---
import PropuestaLayout from '../../layouts/PropuestaLayout.astro';
import NivelDetalle from '../../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '01', titulo: 'Color', desc: 'Formación del color para gráfica virtual y material: modelos RGB, CMYK y hexadecimal.' },
  { num: '02', titulo: 'Imagen digital y web', desc: 'Imagen pixelar y vectorial, modos y modelos de imagen; estándares y lenguajes web.' },
  { num: '03', titulo: 'Generación de originales', desc: 'Producción digital de originales para destino virtual y material.' },
  { num: '04', titulo: 'Papel y computer-to-plate', desc: 'Características y fabricación del papel; el CTP como enlace entre el original y la impresión.' },
  { num: '05', titulo: 'Sistemas de impresión', desc: 'Relieve (flexografía) y profundidad (rotograbado), planográfica (offset), permeográfica (serigrafía) e híbridos y digitales.' },
  { num: '06', titulo: 'Trabajo práctico final — Sistemas', desc: 'Integración de los contenidos aplicada a la producción en un sistema de impresión.' },
];

---

<PropuestaLayout title="Tecnología 1 | Propuesta Zachin" description="Tecnología 1 — Introducción a los procesos de producción gráfica.">
  <NivelDetalle
    nivel={1}
    desc="Reproducción del diseño: color, imagen digital y web, generación de originales, papel y los sistemas de impresión (flexografía, rotograbado, offset, serigrafía e híbridos)."
    mail="cat.zachin.tecno1@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
