const categorias = ['todas', 'jornada', 'taller', 'clase', 'tps'];
---

<BaseLayout title="Galería | Cátedra Zachin" description="Fotos y videos de clases, talleres, jornadas y TPs de la Cátedra Zachin.">
  <section class="page-header">
    <div class="container">
      <span class="page-header__label">Multimedia</span>
      <h1>Galería</h1>
      <p class="page-header__desc">Fotos y videos de clases, talleres, jornadas y TPs de la cátedra.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="galeria-filters" id="galeria-filters">
        {categorias.map(cat => (
          <button
            class:list={['filter-btn', { active: cat === 'todas' }]}
            data-filter={cat}
          >
            {cat === 'tps' ? 'TPs' : cat.charAt(0).toUpperCase() + cat.slice(1)}
          </button>
        ))}
      </div>

      <div class="galeria-grid" id="galeria-grid">
        {items.map((item) => (
          <div class="galeria-item" data-categoria={item.categoria}>
            {item.tipo === 'foto' ? (
              <div class="galeria-item__img">
                <img src={item.src} alt={item.alt} loading="lazy" />
              </div>
            ) : (
              <div class="galeria-item__video">
                <video src={item.src} muted loop playsinline preload="metadata">
                  <track kind="captions" />
                </video>
                <div class="galeria-item__play">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    margin-top: var(--space-sm);
  }

  .page-header__desc {
    margin-top: var(--space-md);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  .galeria-filters {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .filter-btn:hover,
  .filter-btn.active {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .galeria-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .galeria-item__img,
  .galeria-item__video {
    aspect-ratio: 4/3;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    position: relative;
  }

  .galeria-item__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .galeria-item__img:hover img {
    transform: scale(1.05);
  }

  .galeria-item__video {
    cursor: pointer;
  }

  .galeria-item__video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .galeria-item__video:hover video {
    transform: scale(1.05);
  }

  .galeria-item__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    color: white;
    transition: background var(--transition-fast);
    pointer-events: none;
  }

  .galeria-item__video:hover .galeria-item__play {
    background: rgba(0, 0, 0, 0.1);
  }

  .galeria-item__video.playing .galeria-item__play {
    opacity: 0;
  }

  .galeria-item[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .galeria-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .galeria-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const filters = document.getElementById('galeria-filters');
    const grid = document.getElementById('galeria-grid');
    if (!filters || !grid) return;

    // Filter buttons
    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn');
      if (!btn) return;

      filters.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      grid.querySelectorAll('.galeria-item').forEach(item => {
        if (filter === 'todas' || item.getAttribute('data-categoria') === filter) {
          (item as HTMLElement).hidden = false;
        } else {
          (item as HTMLElement).hidden = true;
        }
      });
    });

    // Video play/pause on click
    grid.querySelectorAll('.galeria-item__video').forEach(wrapper => {
      const video = wrapper.querySelector('video');
      if (!video) return;

      wrapper.addEventListener('click', () => {
        if (video.paused) {
          // Pause all other videos first
          grid.querySelectorAll('video').forEach(v => {
            if (v !== video) {
              v.pause();
              v.closest('.galeria-item__video')?.classList.remove('playing');
            }
          });
          video.play();
          wrapper.classList.add('playing');
        } else {
          video.pause();
          wrapper.classList.remove('playing');
        }
      });
    });
  });
</script>
