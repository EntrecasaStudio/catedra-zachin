---
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import Section from '../components/propuesta/Section.astro';
import Grid from '../components/propuesta/Grid.astro';
import GaleriaItem from '../components/propuesta/GaleriaItem.astro';
import { items, categorias, countByCategoria } from '../data/galeria.js';

const counts = countByCategoria(items);
const label = (c) => (c === 'tps' ? 'TPs' : c.charAt(0).toUpperCase() + c.slice(1));
---

<PropuestaLayout title="Registro | Cátedra Zachin" description="Registro: fotos y videos de clases, talleres, jornadas y TPs de la Cátedra Zachin.">
  <section class="gal-hero pz-container" data-reveal-group>
    <span class="pz-eyebrow" data-reveal>Multimedia</span>
    <h1 class="gal-hero__title" data-reveal>Registro</h1>
    <p class="gal-hero__desc" data-reveal>Fotos y videos de clases, talleres, jornadas y TPs de la cátedra.</p>
  </section>

  <Section flush>
    <div class="gal-filters" id="gal-filters" data-reveal role="tablist" aria-label="Filtrar galería por categoría">
      {categorias.map((cat, i) => (
        <button
          class:list={['pz-btn', 'pz-btn--secondary', 'pz-btn--sm', { 'is-active': i === 0 }]}
          data-filter={cat}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {label(cat)}<span class="gal-filters__count">{counts[cat]}</span>
        </button>
      ))}
    </div>

    <Grid data-reveal cols={3} colsMd={2} colsSm={1} id="gal-grid" isEmpty={items.length === 0} emptyText="No hay material cargado todavía.">
      {items.map((item, i) => <GaleriaItem item={item} index={i} />)}
    </Grid>
  </Section>

  <!-- Lightbox -->
  <div class="gal-lightbox" id="gal-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Vista ampliada">
    <button class="gal-lightbox__btn gal-lightbox__close" id="gal-close" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
    </button>
    <button class="gal-lightbox__btn gal-lightbox__nav gal-lightbox__prev" id="gal-prev" aria-label="Anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 5 8 12 15 19" /></svg>
    </button>
    <button class="gal-lightbox__btn gal-lightbox__nav gal-lightbox__next" id="gal-next" aria-label="Siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 5 16 12 9 19" /></svg>
    </button>
    <div class="gal-lightbox__content" id="gal-content"></div>
    <div class="gal-lightbox__info"><span id="gal-counter"></span> · <span id="gal-alt"></span></div>
  </div>
</PropuestaLayout>

<style>
  .gal-hero { padding-block: clamp(2.5rem, 8vh, 5rem) var(--pz-space-xl); }
  .gal-hero__title { font-size: clamp(2.5rem, 10vw, 6rem); margin-top: var(--pz-space-sm); }
  .gal-hero__desc { color: var(--pz-muted); font-size: 1.1rem; margin-top: var(--pz-space-md); }

  .gal-filters { display: flex; flex-wrap: wrap; gap: var(--pz-space-xs); margin-bottom: var(--pz-space-xl); }
  /* Seleccionado: colapsa la sombra y "presiona" hacia donde estaba (feedback) */
  .gal-filters .is-active { background: var(--pz-duo); color: var(--pz-on-accent); border-color: transparent; box-shadow: none; transform: translate(3px, 3px); }
  .gal-filters__count { margin-left: 0.35rem; opacity: 0.6; }

  .gal-lightbox {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0, 0, 0, 0.96);
    opacity: 0; visibility: hidden;
    transition: opacity var(--pz-transition), visibility var(--pz-transition);
  }
  .gal-lightbox.is-open { opacity: 1; visibility: visible; }
  .gal-lightbox__content { max-width: 90vw; max-height: 82vh; display: flex; }
  .gal-lightbox__content :global(img),
  .gal-lightbox__content :global(video) {
    max-width: 90vw; max-height: 82vh; object-fit: contain;
    border: var(--pz-border-width) solid #fff;
  }
  /* Botones brutalistas: caja blanca sólida, glifo negro; hover → gradiente */
  /* Botones en sistema: caja sólida, borde --pz-border-width, radio --pz-radius,
     ícono SVG centrado (mismo peso de línea que el resto). Sobre el overlay negro
     el borde va en blanco para leerse. */
  .gal-lightbox__btn {
    position: absolute; z-index: 2;
    width: 3rem; height: 3rem; display: grid; place-items: center;
    color: #000; background: #fff;
    border: var(--pz-border-width) solid #fff;
    border-radius: var(--pz-radius);
    transition: background var(--pz-transition), color var(--pz-transition);
  }
  .gal-lightbox__btn svg { display: block; width: 1.35rem; height: 1.35rem; }
  /* Hover: se invierte a caja calada (glifo blanco, marco blanco) */
  .gal-lightbox__btn:hover { background: transparent; color: #fff; }
  .gal-lightbox__close { top: 1rem; right: 1rem; }
  .gal-lightbox__nav { top: 50%; transform: translateY(-50%); }
  .gal-lightbox__prev { left: 1rem; }
  .gal-lightbox__next { right: 1rem; }
  /* Info como chip mono sólido */
  .gal-lightbox__info {
    position: absolute; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
    padding: 0.3rem 0.7rem;
    background: #fff; color: #000;
    font-family: var(--pz-font-mono); font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  @media (max-width: 560px) {
    .gal-lightbox__nav { top: auto; bottom: 4.5rem; transform: none; }
    .gal-lightbox__prev { left: 1.5rem; }
    .gal-lightbox__next { right: 1.5rem; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const filters = document.getElementById('gal-filters');
    const grid = document.getElementById('gal-grid');
    const lb = document.getElementById('gal-lightbox');
    const content = document.getElementById('gal-content');
    const counter = document.getElementById('gal-counter');
    const altEl = document.getElementById('gal-alt');
    if (!filters || !grid || !lb || !content) return;

    document.body.appendChild(lb);

    let index = -1;
    let visible = [];
    const getVisible = () => Array.from(grid.querySelectorAll('.pz-galitem:not([hidden])'));

    filters.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-filter]');
      if (!btn) return;
      filters.querySelectorAll('[data-filter]').forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      const f = btn.getAttribute('data-filter');
      grid.querySelectorAll('.pz-galitem').forEach((it) => {
        it.hidden = !(f === 'todas' || it.getAttribute('data-categoria') === f);
      });
    });

    grid.addEventListener('click', (e) => {
      const it = e.target.closest('.pz-galitem');
      if (!it) return;
      visible = getVisible();
      const i = visible.indexOf(it);
      if (i > -1) open(i);
    });

    function show(i) {
      const it = visible[i];
      if (!it) return;
      const tipo = it.getAttribute('data-tipo');
      const src = it.getAttribute('data-src') || '';
      const alt = it.getAttribute('data-alt') || '';
      content.innerHTML = '';
      if (tipo === 'foto') {
        const img = document.createElement('img');
        img.src = src; img.alt = alt;
        content.appendChild(img);
      } else {
        const v = document.createElement('video');
        v.src = src; v.controls = true; v.autoplay = true; v.loop = true; v.playsInline = true;
        content.appendChild(v);
      }
      if (counter) counter.textContent = `${i + 1} / ${visible.length}`;
      if (altEl) altEl.textContent = alt;
    }

    function open(i) {
      index = i;
      show(i);
      lb.classList.add('is-open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lb.classList.remove('is-open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      content.querySelector('video')?.pause();
    }
    function nav(d) {
      const n = index + d;
      if (n < 0 || n >= visible.length) return;
      index = n; show(n);
    }

    document.getElementById('gal-close')?.addEventListener('click', close);
    document.getElementById('gal-prev')?.addEventListener('click', () => nav(-1));
    document.getElementById('gal-next')?.addEventListener('click', () => nav(1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    });
  });
</script>
