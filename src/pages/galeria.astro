  { tipo: 'foto', src: '/images/galeria/jornada/IMG_3868.jpg', alt: 'Jornada Zachin Live', categoria: 'jornada' },
  { tipo: 'foto', src: '/images/galeria/jornada/IMG_3874.jpg', alt: 'Jornada Zachin Live', categoria: 'jornada' },
