---
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import NivelDetalle from '../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '1', titulo: 'Color', desc: 'Cómo se forma y se percibe el color en gráfica virtual y material. Síntesis aditiva y sustractiva, los modelos RGB, CMYK y hexadecimal, y la correspondencia entre el color de pantalla y el color de impresión.' },
  { num: '2', titulo: 'Tecnología y diseño', desc: 'El rol del diseñador dentro del proceso productivo: flujo de trabajo, estandarización y sustentabilidad. Los dispositivos y el software como herramientas de producción.' },
  { num: '3', titulo: 'La imagen digital', desc: 'Naturaleza de la imagen digital: mapa de bits (pixelar) frente a vectorial, resolución y modos de imagen. Los archivos de fuentes tipográficas.' },
  { num: '4', titulo: 'Soportes digitales', desc: 'Los dispositivos como soporte: resoluciones de pantalla, densidad de píxeles y diseño responsivo para adaptar la pieza a cada dispositivo.' },
  { num: '5', titulo: 'Generación digital de originales', desc: 'Producción digital de originales listos para reproducir, para destino virtual y material. Preparación del archivo, criterios de calidad y adecuación a cada sistema de salida.' },
  { num: '6', titulo: 'Web', desc: 'La web como soporte: estándares y lenguajes, hipertexto e interfaces. Fundamentos de usabilidad y experiencia de usuario (UX).' },
  { num: '7', titulo: 'Introducción a la industria gráfica', desc: 'Primer acercamiento a la producción gráfica material: panorama de la industria, sus procesos y su lógica, como puente hacia Tecnología 2.' },
];

---

<PropuestaLayout title="Tecnología 1 | Propuesta Zachin" description="Tecnología 1 — Introducción a los procesos de producción gráfica.">
  <NivelDetalle
    nivel={1}
    desc="Los fundamentos tecnológicos del diseño en soporte virtual: color, tecnología y diseño, imagen digital, soportes digitales, generación de originales, web e introducción a la industria gráfica."
    mail="cat.zachin.tecno1@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
