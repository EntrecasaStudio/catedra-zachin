---
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import NivelDetalle from '../components/propuesta/NivelDetalle.astro';

const programa = [
  { num: '1', titulo: 'Color', desc: 'Formación y percepción del color en gráfica virtual y material. Síntesis aditiva y sustractiva, modelos RGB, CMYK y hexadecimal, y correspondencia entre color de pantalla y color de impresión.' },
  { num: '2', titulo: 'Imagen digital y web', desc: 'Naturaleza de la imagen digital: mapa de bits frente a vectorial, resolución, modos de imagen y archivos tipográficos. La web como soporte: estándares, hipertexto, interfaces y fundamentos de UX.' },
  { num: '3', titulo: 'Originales digitales', desc: 'Producción de originales listos para reproducir en destino virtual y material. Preparación del archivo, criterios de calidad y adecuación a cada sistema de salida.' },
  { num: '4', titulo: 'Papel y preimpresión', desc: 'El papel como soporte de impresión: tipos, formatos, gramaje y acabados. Flujo de preimpresión y generación de formas impresoras (CTP).' },
  { num: '5', titulo: 'Introducción a la industria gráfica', desc: 'Panorama de los sistemas de impresión industriales: offset, flexografía, rotograbado, serigrafía e híbridos. Formas impresoras, tintas, sustratos y aplicaciones de cada sistema.' },
  { num: '6', titulo: 'Impresión digital y bajo demanda', desc: 'Sistemas de impresión digital: tóner y chorro de tinta. Impresión bajo demanda, dato variable, tiradas cortas y nuevas tecnologías de reproducción.' },
];

---

<PropuestaLayout title="Tecnología 1 | Propuesta Zachin" description="Tecnología 1 — Introducción a los procesos de producción gráfica.">
  <NivelDetalle
    nivel={1}
    desc="Los fundamentos tecnológicos del diseño en soporte virtual y material: color, imagen digital y web, originales digitales, papel y preimpresión, introducción a la industria gráfica e impresión digital."
    mail="cat.zachin.tecno1@gmail.com"
    programa={programa}
    cursada={[
      { turno: 'Mañana', detalle: 'Viernes de 09:00 a 13:00 h' },
      { turno: 'Noche', detalle: 'Viernes de 19:00 a 23:00 h' },
    ]}
  />
</PropuestaLayout>
